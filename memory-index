#!/usr/bin/env python3
"""
memory-index — a rebuildable retrieval sidecar over the outl memory graph.

The outl markdown graph at ~/.claude/memory is the sole source of truth. This tool
builds a DERIVED, disposable SQLite index over it (Porter-stemmed, field-weighted FTS5
keyword + a typed/weighted link/edge table) so recall can land on the narrow relevant
band in one shot, then walk
outward along [[links]] via a recursive graph traversal. The index is never
authoritative: delete it and `rebuild` reconstructs it from the markdown on any machine.
Edges are a pure projection of the files — type is inferred from link wording, never
annotated in the markdown — so the source stays clean and there is only one source of truth.

Commands:
  memory-index rebuild            Full reindex from markdown (idempotent).
  memory-index refresh            Incremental: reindex only pages whose hash changed.
  memory-index search "q"         Field-weighted bm25 keyword hits, then a walk of the
                                  typed [[link]] graph out from those hits. Hop depth is
                                  a function of graph size: 1, 2 at 3×threshold, 3 at 10×.
  memory-index stats              Node/chunk/edge counts (with edge-type breakdown),
                                  index freshness, active/inactive.

Design notes:
  * STDLIB ONLY — no third-party packages, no venv, no build step. It relies only on
    Python 3.9+ and the sqlite3/FTS5 that ship with CPython, so it is a single file
    that just works on any machine. The whole index is one SQLite file (.outl/index.sqlite).
  * Auto-scale gate: below --threshold nodes the graph is small enough that agentic
    TOC-traversal beats an index; `stats` reports inactive and callers skip it.
  * Lexical recall is Porter-stemmed (consolidate≈consolidation), diacritic-folded, and
    prefix-matched (consol* → consolidation), over three field-weighted FTS columns
    (title ≫ heading ≫ body via BM25_WEIGHTS) — all pure SQLite/FTS5, no model.
"""

from __future__ import annotations

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

WS_DEFAULT = os.path.expanduser("~/.claude/memory")
SCHEMA_VERSION = 3  # stemmed/field-weighted FTS (title/heading/body columns)
DEFAULT_THRESHOLD = 150  # node count at/above which the index is considered "active"

# Field weights for bm25 over the (title, heading, text) FTS columns. A hit in the page
# title outranks a section-heading hit, which outranks an incidental body mention.
BM25_WEIGHTS = (10.0, 4.0, 1.0)

FRECENCY_SEED = 30  # per AGENTS.md: a fresh leaf seeds at 30
FRECENCY_CAP = 60   # per AGENTS.md: frecency saturates at 60
FRECENCY_BUMP = 5   # per AGENTS.md: a material use credits +5 (see `touch`)
RETENTION_COUNT = 5  # keep the 5 most recent journal files; anything older is aged out
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

# Retrieval-graph heals (see cmd_medic). Each prunes pathological edges from the DERIVED
# edge table only — the markdown source is never touched. `dangling` + `selfloop` are
# unambiguously performance/precision-positive and are the medic default; `caphubs` and
# `superseded` are more aggressive and opt-in. The active set is stored in meta so every
# rebuild/refresh (incl. the SessionStart hook's) re-applies it and the graph stays healthy.
HEAL_DEFAULT = "dangling,selfloop"
FRECENCY_RISK = 5  # a knowledge leaf at/below this frecency is nearing prune (seed is 30)

# Split-on-growth (per AGENTS.md): a `type:: knowledge` leaf whose body is estimated to cost
# more than this many tokens to load should be carved into a TOC + `<slug>-<section>` child
# leaves. Estimated as len(body)//CHARS_PER_TOKEN — what an outl_page_get actually spends —
# not by lines/words, which undercount markup- and code-heavy pages. ~1800 ≈ 3.5× the median
# leaf, the point where loading the whole page clearly beats descending a TOC. Env-tunable.
CHARS_PER_TOKEN = 4
SPLIT_TOKENS = int(os.environ.get("MEMORY_SPLIT_TOKENS", "1800"))

# A small closed-class stopword set. Stripped from FTS queries so a full-sentence query
# (e.g. one pushed straight from a user prompt) is not OR'd token-by-token into low-IDF
# noise that pollutes bm25 ranking. Deliberately tiny — only words that carry no recall
# signal — so it never drops a real content term. If a query is ALL stopwords, the caller
# falls back to the raw terms rather than matching nothing.
STOPWORDS = frozenset("""
a an and the or of to in is are was were be been being for on with as at by it its this
that these those i you we they he she my our your their from about into if then than so
but not no do does did can could should would will just how what why when where who which
me us them there here have has had get got make made want need please thanks
""".split())

FM_RE = re.compile(r"^([A-Za-z_][\w-]*)::\s?(.*)$")
LINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
SECTION_RE = re.compile(r"^\s*-\s+(#{1,6})\s+(.*)$")  # a bullet whose text is a heading

# Frontmatter keys that MUST be hoisted (parse_md only reads `key:: value` lines ABOVE the
# first bullet). When one of these appears as a body bullet instead, the parser — and so the
# index, maintain, and touch — never sees it, and the page silently falls out of tracking
# (e.g. a leaf missing `type:: knowledge` is invisible to the frecency sweep). doctor flags it.
HOISTABLE_KEYS = ("type", "frecency", "seen", "parent", "project", "summary",
                  "updated", "tags", "status", "pin", "source", "icon", "aliases")
PROP_BULLET_RE = re.compile(
    r"^\s*-?\s*(" + "|".join(HOISTABLE_KEYS) + r")::\s", re.IGNORECASE)


# --------------------------------------------------------------------------- db
def db_path(ws: str) -> str:
    return os.path.join(ws, ".outl", "index.sqlite")


def connect(ws: str):
    import sqlite3

    path = db_path(ws)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    con = sqlite3.connect(path)
    con.execute("PRAGMA journal_mode=WAL")
    return con


def init_schema(con):
    con.executescript(
        """
        CREATE TABLE IF NOT EXISTS pages (
            slug        TEXT PRIMARY KEY,
            kind        TEXT NOT NULL,          -- 'page' | 'journal'
            path        TEXT NOT NULL,
            page_hash   TEXT,                   -- sha256 of the .md, for incremental refresh
            title       TEXT,
            summary     TEXT,
            updated     TEXT,
            frecency    INTEGER
        );
        CREATE TABLE IF NOT EXISTS chunks (
            id          INTEGER PRIMARY KEY,
            slug        TEXT NOT NULL,
            title       TEXT,                   -- page title, denormalized for field-weighting
            heading     TEXT,                   -- e.g. "## Decisions" or "(top)"
            anchor      TEXT,                   -- best-effort blk-ref handle, or ''
            text        TEXT NOT NULL
        );
        CREATE INDEX IF NOT EXISTS chunks_slug ON chunks(slug);
        CREATE TABLE IF NOT EXISTS edges (
            src    TEXT NOT NULL,
            dst    TEXT NOT NULL,
            type   TEXT NOT NULL DEFAULT 'refs',   -- refs | supersedes | contradicts | part-of
            weight INTEGER NOT NULL DEFAULT 1,      -- link multiplicity: how strongly src cites dst
            UNIQUE(src, dst, type)
        );
        CREATE INDEX IF NOT EXISTS edges_dst ON edges(dst);
        -- Stemmed (Porter) + diacritic-folded FTS with three weighted columns. External
        -- content over `chunks`, so column names MUST match chunks(title,heading,text).
        CREATE VIRTUAL TABLE IF NOT EXISTS chunks_fts
            USING fts5(title, heading, text, content='chunks', content_rowid='id',
                       tokenize='porter unicode61 remove_diacritics 2');
        CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT);
        """
    )
    set_meta(con, "schema_version", str(SCHEMA_VERSION))
    con.commit()


def set_meta(con, k: str, v: str):
    con.execute(
        "INSERT INTO meta(key,value) VALUES(?,?) "
        "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
        (k, v),
    )


def get_meta(con, k: str, default=None):
    row = con.execute("SELECT value FROM meta WHERE key=?", (k,)).fetchone()
    return row[0] if row else default


def _has_meta(con) -> bool:
    return con.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='meta'"
    ).fetchone() is not None


def _schema_ok(con) -> bool:
    """True if the on-disk index matches the current SCHEMA_VERSION. A version bump
    makes the DERIVED index stale; since it's disposable we rebuild from markdown rather
    than migrate in place. A brand-new (tableless) db is 'ok' — init_schema will create
    it fresh at the current version."""
    if not _has_meta(con):
        pages_exists = con.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='pages'"
        ).fetchone() is not None
        return not pages_exists  # no pages yet => empty db, fine; pages but no meta => stale
    v = get_meta(con, "schema_version")
    return v is not None and int(v) == SCHEMA_VERSION


def _needs_build(con, ws: str) -> bool:
    """True when the index is EMPTY (no pages) but the workspace has markdown to index —
    i.e. it was never built, or the .sqlite was deleted and merely re-created empty by
    connect(). Distinct from a stale schema (handled by _schema_ok): here the schema is
    fine, there's just nothing in it. Without this, a `search` that is the first command
    to touch an empty index returns nothing and depends on `refresh`/`rebuild` having run
    first — so push-retrieval could go silently dark if the index is missing when a prompt
    fires."""
    has_pages = con.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='pages'"
    ).fetchone() is not None
    n = con.execute("SELECT COUNT(*) FROM pages").fetchone()[0] if has_pages else 0
    if n > 0:
        return False
    return any(True for _ in iter_source_files(ws))


def _open_current(ws: str):
    """connect() to the index, transparently rebuilding it first if the on-disk schema is
    stale OR the index is empty over a populated workspace. Read/refresh commands go through
    here so a schema bump self-heals and a never-built/deleted index self-initializes."""
    con = connect(ws)
    if not _schema_ok(con) or _needs_build(con, ws):
        con.close()
        cmd_rebuild(ws, None, quiet=True)
        con = connect(ws)
    return con


# ---------------------------------------------------------------- markdown parse
def parse_md(path: str):
    """Return (frontmatter dict, body_lines list) from a rendered outl .md file."""
    with open(path, "r", encoding="utf-8") as f:
        raw = f.read()
    lines = raw.splitlines()
    fm = {}
    i = 0
    # Frontmatter = leading `key:: value` lines, up to the first bullet/blank break.
    while i < len(lines):
        ln = lines[i]
        if ln.strip() == "":
            i += 1
            continue
        if ln.lstrip().startswith("-"):
            break
        m = FM_RE.match(ln)
        if m:
            fm[m.group(1)] = m.group(2).strip()
            i += 1
        else:
            break
    body = lines[i:]
    return fm, body, raw


def chunk_body(fm: dict, body: list[str]):
    """Split a page body into section-sized chunks: one per `## heading` bullet
    (with its descendants), plus a synthetic title+summary chunk. Coherent units
    for keyword indexing, and clean `slug › heading` pointers."""
    chunks = []  # (heading, text)
    title = fm.get("title") or ""
    summary = fm.get("summary") or ""
    if title or summary:
        chunks.append(("(summary)", f"{title}. {summary}".strip(". ").strip()))

    cur_head = "(top)"
    cur_lines: list[str] = []

    def flush():
        text = "\n".join(l for l in cur_lines).strip()
        if text:
            chunks.append((cur_head, text))

    for ln in body:
        m = SECTION_RE.match(ln)
        if m:
            flush()
            cur_head = m.group(2).strip()
            cur_lines = [m.group(2).strip()]
        else:
            cur_lines.append(ln.strip())
    flush()
    return chunks


# Edge-type inference: the markdown is NEVER annotated with a link type — files stay
# clean, source-of-truth intact — so the type is derived from the wording of the line
# the [[link]] sits on. First keyword group to match wins; otherwise a plain 'refs'.
EDGE_TYPES = (
    ("supersedes",  ("supersede", "replaces", "replace", "obsoletes", "deprecates")),
    ("contradicts", ("contradict", "conflicts", "conflict", "disagrees", "refutes")),
    ("part-of",     ("part of", "parent", "belongs to", "under ", "child of", "subpage")),
)


def _edge_type(line: str) -> str:
    low = line.lower()
    for etype, kws in EDGE_TYPES:
        if any(kw in low for kw in kws):
            return etype
    return "refs"


def links_in(body: list[str]) -> dict[tuple[str, str], int]:
    """Map every [[link]] to a typed, weighted edge. Type is INFERRED from the line's
    wording (see EDGE_TYPES; else 'refs'); weight is the link's multiplicity within the
    page. Returns {(target, type): weight}."""
    out: dict[tuple[str, str], int] = {}
    for ln in body:
        etype = _edge_type(ln)
        for m in LINK_RE.finditer(ln):
            target = m.group(1).split("|")[0].split("#")[0].strip()
            if target:
                key = (target, etype)
                out[key] = out.get(key, 0) + 1
    return out


def sha256_text(s: str) -> str:
    return "sha256:" + hashlib.sha256(s.encode("utf-8")).hexdigest()


def iter_source_files(ws: str):
    """Yield (slug, kind, path) for every indexable .md, skipping templates."""
    for kind, sub in (("page", "pages"), ("journal", "journals")):
        for path in sorted(glob.glob(os.path.join(ws, sub, "*.md"))):
            slug = os.path.splitext(os.path.basename(path))[0]
            if slug.startswith("templates-"):
                continue
            yield slug, kind, path


# ----------------------------------------------------------------------- verbs
def cmd_rebuild(ws: str, threshold: int | None, quiet: bool = False):
    con = connect(ws)
    # Preserve an existing threshold across a rebuild unless one is passed explicitly.
    prior = get_meta(con, "threshold") if _has_meta(con) else None
    resolved = threshold if threshold is not None else (
        int(prior) if prior is not None else DEFAULT_THRESHOLD
    )
    con.execute("DROP TABLE IF EXISTS chunks_fts")
    con.execute("DROP TABLE IF EXISTS vectors")  # legacy: drop if a prior version made it
    for t in ("pages", "chunks", "edges"):
        con.execute(f"DROP TABLE IF EXISTS {t}")
    init_schema(con)
    set_meta(con, "threshold", str(resolved))
    _index_files(con, ws, list(iter_source_files(ws)), full=True)
    con.commit()
    if not quiet:
        _print_stats(con, ws)
    con.close()


def cmd_refresh(ws: str, threshold: int | None, quiet: bool = False):
    con = _open_current(ws)
    init_schema(con)
    if get_meta(con, "threshold") is None:
        set_meta(con, "threshold", str(threshold if threshold is not None else DEFAULT_THRESHOLD))
    known = dict(con.execute("SELECT slug, page_hash FROM pages").fetchall())
    files = list(iter_source_files(ws))
    live = {slug for slug, _, _ in files}
    # Drop pages that no longer exist.
    for slug in list(known):
        if slug not in live:
            _delete_slug(con, slug)
    # Reindex only changed/new pages.
    changed = []
    for slug, kind, path in files:
        with open(path, "r", encoding="utf-8") as f:
            h = sha256_text(f.read())
        if known.get(slug) != h:
            changed.append((slug, kind, path))
    _index_files(con, ws, changed, full=False)
    con.commit()
    if not quiet:
        print(f"refreshed {len(changed)} page(s); {len(known)} known before")
    con.close()


def _delete_slug(con, slug: str):
    # External-content FTS5 deletes must replay the ORIGINAL column values so the exact
    # tokens are removed; passing '' (as an earlier version did) leaks stale terms.
    rows = con.execute(
        "SELECT id, title, heading, text FROM chunks WHERE slug=?", (slug,)
    ).fetchall()
    for cid, title, heading, text in rows:
        con.execute(
            "INSERT INTO chunks_fts(chunks_fts, rowid, title, heading, text) "
            "VALUES('delete', ?, ?, ?, ?)",
            (cid, title or "", heading or "", text or ""),
        )
    con.execute("DELETE FROM chunks WHERE slug=?", (slug,))
    con.execute("DELETE FROM edges WHERE src=?", (slug,))
    con.execute("DELETE FROM pages WHERE slug=?", (slug,))


def _index_files(con, ws: str, files, full: bool):
    for slug, kind, path in files:
        if not full:
            _delete_slug(con, slug)
        fm, body, raw = parse_md(path)
        con.execute(
            "INSERT INTO pages(slug,kind,path,page_hash,title,summary,updated,frecency) "
            "VALUES(?,?,?,?,?,?,?,?)",
            (
                slug,
                kind,
                path,
                sha256_text(raw),
                fm.get("title"),
                fm.get("summary"),
                fm.get("updated"),
                _int_or_none(fm.get("frecency")),
            ),
        )
        page_title = fm.get("title") or ""
        for heading, text in chunk_body(fm, body):
            # Put the page title in the weighted `title` column ONLY on the synthetic
            # summary chunk (the page's headline representation). Denormalizing it onto
            # every chunk would make the title term appear corpus-wide, crushing its IDF
            # and destroying the very discrimination the weight is meant to add.
            fts_title = page_title if heading == "(summary)" else ""
            cur = con.execute(
                "INSERT INTO chunks(slug,title,heading,anchor,text) VALUES(?,?,?,?,?)",
                (slug, fts_title, heading, "", text),
            )
            con.execute(
                "INSERT INTO chunks_fts(rowid, title, heading, text) VALUES(?,?,?,?)",
                (cur.lastrowid, fts_title, heading, text),
            )
        for (dst, etype), weight in links_in(body).items():
            con.execute(
                "INSERT OR IGNORE INTO edges(src,dst,type,weight) VALUES(?,?,?,?)",
                (slug, dst, etype, weight),
            )
    _apply_heals(con)  # re-prune the edge table per the stored heal policy (no-op if unset)
    set_meta(con, "indexed_at", str(int(time.time())))


def _int_or_none(s):
    try:
        return int(s)
    except (TypeError, ValueError):
        return None


def _graph_expand(con, seeds, depth: int, limit: int):
    """N-hop neighbourhood of the seed slugs over the (undirected) [[link]] graph, via
    a single recursive CTE. Walks up to `depth` hops, terminating on the depth bound (so
    cycles are safe), then keeps for each reached node its NEAREST/strongest arrival
    (min depth, then max edge weight). Returns [(slug, depth, weight, type, via)] ordered
    nearest- and strongest-first, seeds themselves excluded."""
    if not seeds or depth < 1:
        return []
    seed_vals = ",".join("(?)" for _ in seeds)
    sql = f"""
        WITH RECURSIVE
          seed(slug) AS (VALUES {seed_vals}),
          undirected(a, b, type, weight) AS (
              SELECT src, dst, type, weight FROM edges
              UNION ALL
              SELECT dst, src, type, weight FROM edges
          ),
          walk(slug, depth, weight, type, via) AS (
              SELECT slug, 0, 0, '', slug FROM seed
            UNION
              SELECT u.b, w.depth + 1, u.weight, u.type, w.slug
              FROM walk w
              JOIN undirected u ON u.a = w.slug
              WHERE w.depth < ?
          ),
          ranked AS (
              SELECT slug, depth, weight, type, via,
                     ROW_NUMBER() OVER (
                         PARTITION BY slug ORDER BY depth ASC, weight DESC
                     ) AS rn
              FROM walk
              WHERE depth > 0
          )
        SELECT slug, depth, weight, type, via
        FROM ranked
        WHERE rn = 1 AND slug NOT IN (SELECT slug FROM seed)
        ORDER BY depth ASC, weight DESC
        LIMIT ?
    """
    return con.execute(sql, list(seeds) + [depth, limit]).fetchall()


def _auto_depth(con) -> int:
    """Hop depth as a function of graph size, relative to the active threshold t:
    1 hop below 3t, 2 at 3t, 3 at 10t."""
    n = con.execute("SELECT COUNT(*) FROM pages").fetchone()[0]
    t = int(get_meta(con, "threshold", str(DEFAULT_THRESHOLD)))
    if n >= 10 * t:
        return 3
    if n >= 3 * t:
        return 2
    return 1


def _keyword_hits(con, query: str, k: int):
    """Field-weighted bm25 chunk hits, best-first. Weights (title,heading,text) so a
    page-title match outranks a heading match outranks a body mention. Returns
    [(slug, heading, text, bm25)] (lower bm25 == better)."""
    w = ", ".join(str(x) for x in BM25_WEIGHTS)
    try:
        return con.execute(
            f"SELECT c.slug, c.heading, c.text, bm25(chunks_fts, {w}) AS r "
            "FROM chunks_fts JOIN chunks c ON c.id = chunks_fts.rowid "
            "WHERE chunks_fts MATCH ? ORDER BY r LIMIT ?",
            (_fts_query(query), k),
        ).fetchall()
    except Exception:
        return []


def cmd_search(ws: str, query: str, k: int, no_graph: bool, as_json: bool = False):
    con = _open_current(ws)
    init_schema(con)
    depth = _auto_depth(con)
    # --- field-weighted bm25 (title ≫ heading ≫ body); lower bm25 == better match ---
    results = []
    seeds = []
    for slug, heading, text, r in _keyword_hits(con, query, k):
        results.append(("hit", slug, heading, text, r))
        if slug not in seeds:
            seeds.append(slug)

    # --- graph expansion: up to `depth` hops out from the seeds over typed [[links]] ---
    if not no_graph and seeds:
        for cand, d, weight, etype, via in _graph_expand(con, seeds, depth, k):
            row = con.execute(
                "SELECT summary FROM pages WHERE slug=?", (cand,)
            ).fetchone()
            summary = (row[0] if row and row[0] else "(no summary)")
            label = f"(via {via} · {etype} · {d}h ·w{weight})"
            results.append(("link", cand, label, summary, 0.0))

    if as_json:
        # Machine shape for programmatic callers (e.g. the UserPromptSubmit push-retrieval
        # hook), so gating/dedupe live in the caller, not in scraped human text. `score` is
        # raw bm25 for keyword hits (lower == better; graph rows carry null) and `heading`
        # on a graph row is the `(via … · type · Nh · wW)` provenance label.
        out = {"query": query, "depth": depth, "results": [
            {"kind": kind, "slug": slug, "heading": heading,
             "snippet": " ".join(text.split())[:200],
             "score": (None if kind == "link" else round(score, 4))}
            for kind, slug, heading, text, score in results
        ]}
        print(json.dumps(out))
    else:
        _render_results(query, results)
    con.close()


def _fts_query(q: str) -> str:
    # OR the terms so paraphrase-ish queries still match; each is a PREFIX token ("term"*)
    # so "consol" reaches "consolidation". The Porter tokenizer additionally stems both
    # sides, so morphological variants collapse before prefixing. Quote to stay safe
    # against FTS5 operator characters in the raw query.
    terms = re.findall(r"[A-Za-z0-9_]+", q)
    kept = [t for t in terms if t.lower() not in STOPWORDS and len(t) > 1]
    kept = kept or terms  # all-stopword query: fall back to raw terms rather than match nothing
    return " OR ".join(f'"{t}"*' for t in kept) if kept else '""'


def _render_results(query: str, results):
    if not results:
        print(f'No matches for "{query}" [keyword].')
        return
    print(f'Results for "{query}" [keyword]:\n')
    for kind, slug, heading, text, score in results:
        snippet = " ".join(text.split())[:200]
        if kind == "hit":
            print(f"● {slug} › {heading}   (score {score:.4f})")
            print(f"    {snippet}")
            print(f"    → expand: outl_page_get {slug}\n")
        else:
            print(f"↳ {slug}  {heading}")
            print(f"    {snippet}")
            print(f"    → expand: outl_page_get {slug}\n")


# ------------------------------------------------ link-graph health (doctor/medic)
def _parse_policy(s: str):
    """A heal policy is a comma list of ops, each optionally `name:param` (e.g.
    'dangling,selfloop,caphubs:12'). Returns [(name, param_or_None), ...]."""
    ops = []
    for tok in (s or "").split(","):
        tok = tok.strip()
        if not tok:
            continue
        name, sep, param = tok.partition(":")
        ops.append((name.strip(), param.strip() if sep else None))
    return ops


def _heal_count(con, name: str, param) -> int:
    """How many edges the given heal WOULD remove from the current edge table."""
    if name == "dangling":  # edge → a slug that is not a real page (can't yield a hop)
        return con.execute(
            "SELECT COUNT(*) FROM edges WHERE dst NOT IN (SELECT slug FROM pages)"
        ).fetchone()[0]
    if name == "selfloop":
        return con.execute("SELECT COUNT(*) FROM edges WHERE src = dst").fetchone()[0]
    if name == "superseded":  # plain refs INTO a page something supersedes (stale target)
        return con.execute(
            "SELECT COUNT(*) FROM edges WHERE type='refs' "
            "AND dst IN (SELECT dst FROM edges WHERE type='supersedes')"
        ).fetchone()[0]
    if name == "caphubs":  # per-source out-edges beyond the top-N by weight
        n = int(param or 12)
        return con.execute(
            "SELECT COUNT(*) FROM (SELECT ROW_NUMBER() OVER "
            "(PARTITION BY src ORDER BY weight DESC, dst) AS rn FROM edges) WHERE rn > ?",
            (n,),
        ).fetchone()[0]
    return 0


def _heal_delete(con, name: str, param) -> int:
    if name == "dangling":
        cur = con.execute("DELETE FROM edges WHERE dst NOT IN (SELECT slug FROM pages)")
    elif name == "selfloop":
        cur = con.execute("DELETE FROM edges WHERE src = dst")
    elif name == "superseded":
        cur = con.execute(
            "DELETE FROM edges WHERE type='refs' "
            "AND dst IN (SELECT dst FROM edges WHERE type='supersedes')"
        )
    elif name == "caphubs":
        n = int(param or 12)
        cur = con.execute(
            "DELETE FROM edges WHERE rowid IN (SELECT rowid FROM (SELECT rowid, "
            "ROW_NUMBER() OVER (PARTITION BY src ORDER BY weight DESC, dst) AS rn "
            "FROM edges) WHERE rn > ?)",
            (n,),
        )
    else:
        return 0
    return cur.rowcount


def _heal_plan(con, ops):
    """{label: count} the desired ops WOULD remove from the CURRENT edge table. Counts
    are computed independently, so overlapping ops (e.g. an edge both dangling and a
    self-loop) may be double-counted — it's a preview, not an exact sum."""
    return {(n if not p else f"{n}:{p}"): _heal_count(con, n, p) for n, p in ops}


def _apply_heals(con):
    """Apply the stored heal policy to the edge table. Called at the end of every
    (re)index, so the graph stays healthy across the hook's refreshes. Records the last
    run in meta and returns {label: removed}. No-op (and no record) when no policy is set."""
    ops = _parse_policy(get_meta(con, "heal_policy", "") or "")
    if not ops:
        return {}
    before = con.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
    removed = {(n if not p else f"{n}:{p}"): _heal_delete(con, n, p) for n, p in ops}
    after = con.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
    set_meta(con, "heal_last", json.dumps(
        {"ts": int(time.time()), "policy": get_meta(con, "heal_policy"),
         "removed": removed, "before": before, "after": after}))
    return removed


def _graph_health(con) -> dict:
    """Structural health of the derived [[link]] graph: reach (orphans, components),
    waste (dangling, self-loops), noise risk (hubs, superseded targets), decay (low
    frecency). All read-only — computed from the index, source untouched."""
    allslugs = {r[0] for r in con.execute("SELECT slug FROM pages")}
    npages = con.execute("SELECT COUNT(*) FROM pages WHERE kind='page'").fetchone()[0]
    njournals = con.execute("SELECT COUNT(*) FROM pages WHERE kind='journal'").fetchone()[0]
    edges = con.execute("SELECT src, dst, type, weight FROM edges").fetchall()
    nedges = len(edges)
    by_type = dict(con.execute("SELECT type, COUNT(*) FROM edges GROUP BY type").fetchall())

    dangling = sorted({d for _s, d, _t, _w in edges if d not in allslugs})
    selfloops = sorted({s for s, d, _t, _w in edges if s == d})

    deg, outdeg = {}, {}
    for s, d, _t, _w in edges:
        deg[s] = deg.get(s, 0) + 1
        deg[d] = deg.get(d, 0) + 1
        outdeg[s] = outdeg.get(s, 0) + 1
    orphans = sorted(s for s in allslugs if s not in deg)
    hub_slug, hub_deg = (max(outdeg.items(), key=lambda kv: kv[1]) if outdeg else (None, 0))

    # Connected components over undirected edges among REAL nodes (union-find).
    parent = {n: n for n in allslugs}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    for s, d, _t, _w in edges:
        if s in parent and d in parent:
            ra, rb = find(s), find(d)
            if ra != rb:
                parent[ra] = rb
    comp_sizes = {}
    for n in allslugs:
        r = find(n)
        comp_sizes[r] = comp_sizes.get(r, 0) + 1
    ncomp = len(comp_sizes)
    largest = max(comp_sizes.values()) if comp_sizes else 0

    superseded = sorted({r[0] for r in
                         con.execute("SELECT DISTINCT dst FROM edges WHERE type='supersedes'")})
    frisk = con.execute(
        "SELECT slug, frecency FROM pages WHERE frecency IS NOT NULL AND frecency <= ? "
        "ORDER BY frecency, slug", (FRECENCY_RISK,)
    ).fetchall()

    return {
        "pages": npages, "journals": njournals, "nodes": len(allslugs), "edges": nedges,
        "edge_types": by_type,
        "avg_degree": round(2 * nedges / len(allslugs), 2) if allslugs else 0.0,
        "hub": {"slug": hub_slug, "out_degree": hub_deg},
        "orphans": orphans,
        "dangling_targets": dangling,
        "self_loops": selfloops,
        "components": ncomp, "largest_component": largest,
        "superseded_targets": superseded,
        "frecency_risk": [{"slug": s, "frecency": f} for s, f in frisk],
        "heal_policy": get_meta(con, "heal_policy"),
    }


def _cap(items, n=8):
    items = list(items)
    if len(items) <= n:
        return ", ".join(map(str, items)) or "(none)"
    return ", ".join(map(str, items[:n])) + f"  (+{len(items) - n} more)"


def _unhoisted_props(ws: str) -> dict:
    """Pages whose BODY contains a `key:: value` bullet for a hoistable key — i.e. props
    authored as bullets instead of frontmatter, which parse_md cannot see. Returns
    {slug: [keys]}. Read-only, from the source markdown. This is the guard against the
    silent-untracked trap: a leaf whose `type:: knowledge` lives in the body is invisible
    to the frecency sweep, so it never decays or gets credited."""
    out = {}
    for slug, kind, path in iter_source_files(ws):
        if kind != "page":
            continue
        _fm, body, _raw = parse_md(path)
        found = []
        for ln in body:
            if SECTION_RE.match(ln):  # a `- ## heading` bullet is not a prop
                continue
            m = PROP_BULLET_RE.match(ln)
            if m:
                found.append(m.group(1).lower())
        if found:
            out[slug] = sorted(set(found))
    return out


def cmd_doctor(ws: str, as_json: bool):
    con = _open_current(ws)
    init_schema(con)
    h = _graph_health(con)
    con.close()
    h["unhoisted_props"] = _unhoisted_props(ws)
    if as_json:
        print(json.dumps(h))
        return
    et = ", ".join(f"{t}:{n}" for t, n in sorted(h["edge_types"].items())) or "(none)"
    print(f"workspace : {ws}")
    print(f"nodes     : {h['nodes']}  (pages {h['pages']}, journals {h['journals']})")
    print(f"edges     : {h['edges']}   types: {et}")
    print(f"avg degree: {h['avg_degree']}   hub: "
          f"{h['hub']['slug']} (out {h['hub']['out_degree']})")
    print(f"reach     : {h['components']} component(s), largest {h['largest_component']}"
          f"/{h['nodes']} node(s)")
    print(f"orphans   : {len(h['orphans'])}  {_cap(h['orphans'])}")
    print(f"dangling  : {len(h['dangling_targets'])} target(s)  {_cap(h['dangling_targets'])}")
    print(f"self-loops: {len(h['self_loops'])}  {_cap(h['self_loops'])}")
    print(f"superseded: {len(h['superseded_targets'])} target(s)  {_cap(h['superseded_targets'])}")
    fr = [f"{d['slug']}({d['frecency']})" for d in h["frecency_risk"]]
    print(f"decay-risk: {len(fr)} leaf/leaves ≤{FRECENCY_RISK}  {_cap(fr)}")
    up = h["unhoisted_props"]
    up_disp = [f"{s}({','.join(k)})" for s, k in up.items()]
    print(f"unhoisted : {len(up)} page(s) with props as body bullets  {_cap(up_disp)}")
    print(f"heals     : {h['heal_policy'] or '(none active — run `memory-index medic`)'}")
    # Verdict: name the actionable pathologies, performance-first.
    flags = []
    if h["dangling_targets"]:
        flags.append(f"{len(h['dangling_targets'])} dangling target(s) waste traversal")
    if h["self_loops"]:
        flags.append(f"{len(h['self_loops'])} self-loop(s)")
    if h["components"] > 1:
        flags.append(f"graph fragmented into {h['components']} islands (assoc. recall can't cross them)")
    if h["orphans"]:
        flags.append(f"{len(h['orphans'])} orphan(s) unreachable by graph walk")
    if up:
        flags.append(f"{len(up)} page(s) have props as body bullets (invisible to the parser — "
                     f"hoist to frontmatter via `outl page prop set`, or the page falls out of tracking)")
    print("\nverdict   : " + ("healthy — nothing to prune" if not flags
                              else "; ".join(flags) + "  →  `memory-index medic`"))


def cmd_medic(ws: str, dry_run: bool, cap_hubs, prune_superseded: bool,
              off: bool, as_json: bool):
    # Assemble the desired policy from flags. Default = the safe, perf-positive pair.
    if off:
        desired = ""
    else:
        ops = list(HEAL_DEFAULT.split(","))
        if prune_superseded:
            ops.append("superseded")
        if cap_hubs:
            ops.append(f"caphubs:{cap_hubs}")
        desired = ",".join(ops)

    if dry_run:
        con = _open_current(ws)
        init_schema(con)
        plan = _heal_plan(con, _parse_policy(desired))
        cur = get_meta(con, "heal_policy")
        con.close()
        if as_json:
            print(json.dumps({"dry_run": True, "desired": desired,
                              "current_policy": cur, "would_remove": plan}))
            return
        print(f"medic --dry-run  (desired policy: {desired or '(none)'})")
        print(f"  current policy : {cur or '(none)'}")
        print("  would remove from the CURRENT edge table:")
        for label, n in plan.items():
            print(f"    {label:<14} {n}")
        print("  (counts are independent; overlapping edges may be double-counted)")
        return

    # Apply: persist the policy, then rebuild so edges are re-derived from markdown and
    # re-healed. Rebuild handles both enabling (prune) and --off (restore) uniformly.
    con = connect(ws)
    init_schema(con)
    set_meta(con, "heal_policy", desired)
    con.commit()
    con.close()
    cmd_rebuild(ws, None, quiet=True)

    con = connect(ws)
    last = get_meta(con, "heal_last")
    total = con.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
    con.close()
    info = json.loads(last) if last else {}
    if as_json:
        print(json.dumps({"applied": desired or None, "edges_after": total, "last": info}))
        return
    if not desired:
        print(f"medic: heals DISABLED — edge table restored from markdown ({total} edges).")
        return
    removed = info.get("removed", {})
    print(f"medic: applied heal policy '{desired}'")
    print(f"  edges {info.get('before', '?')} → {info.get('after', total)}")
    for label, n in removed.items():
        print(f"    -{n:<4} {label}")
    print("  policy persisted; the SessionStart hook's refresh will keep it applied.")
    print("  (markdown source untouched — dead [[links]] remain as placeholders)")


def cmd_stats(ws: str, threshold_arg: int, as_json: bool):
    con = _open_current(ws)
    init_schema(con)
    _print_stats(con, ws, threshold_arg, as_json)
    con.close()


def _print_stats(con, ws: str, threshold_arg: int | None = None, as_json: bool = False):
    npages = con.execute("SELECT COUNT(*) FROM pages").fetchone()[0]
    nchunks = con.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
    nedges = con.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
    threshold = threshold_arg if threshold_arg is not None else int(
        get_meta(con, "threshold", str(DEFAULT_THRESHOLD))
    )
    active = npages >= threshold
    indexed_at = get_meta(con, "indexed_at")
    edge_types = dict(
        con.execute("SELECT type, COUNT(*) FROM edges GROUP BY type").fetchall()
    )
    data = {
        "pages": npages,
        "chunks": nchunks,
        "edges": nedges,
        "edge_types": edge_types,
        "threshold": threshold,
        "active": active,
        "indexed_at": int(indexed_at) if indexed_at else None,
    }
    if as_json:
        print(json.dumps(data))
        return
    age = "never"
    if indexed_at:
        age = f"{int((time.time() - int(indexed_at)) / 60)} min ago"
    by_type = con.execute(
        "SELECT type, COUNT(*) FROM edges GROUP BY type ORDER BY COUNT(*) DESC"
    ).fetchall()
    edge_breakdown = ", ".join(f"{t}:{n}" for t, n in by_type) or "(none)"
    print(f"workspace : {ws}")
    print(f"pages     : {npages}   chunks: {nchunks}   edges: {nedges}")
    print(f"edge types: {edge_breakdown}")
    print(f"indexed   : {age}")
    heal = get_meta(con, "heal_policy")
    if heal:
        print(f"heals     : {heal}  (run `memory-index doctor` for graph health)")
    print(f"threshold : {threshold}  →  index {'ACTIVE' if active else 'inactive (small graph — use TOC traversal)'}")


# -------------------------------------------------- maintenance (frecency decay)
def _outl_bin() -> str | None:
    cand = os.environ.get("OUTL_BIN") or shutil.which("outl") or "/opt/homebrew/bin/outl"
    return cand if os.path.exists(cand) else shutil.which("outl")


def _truthy(v) -> bool:
    return str(v).strip().lower() in ("true", "1", "yes")


def cmd_maintain(ws: str, today: str, dry_run: bool, as_json: bool):
    """Daily frecency sweep, per AGENTS.md. For each non-pinned `type:: knowledge`
    leaf not already decayed today: frecency -= 1 (seed 30 if unset), set seen=today.
    Writes go through `outl page prop set` so the .outl sidecar stays in sync — never
    raw .md edits. Leaves reaching 0 are REPORTED as prune candidates, not deleted:
    deletion needs parent-TOC link cleanup, which stays a reviewed agent action."""
    outl = _outl_bin()
    if outl is None and not dry_run:
        print("memory-index maintain: outl binary not found; cannot write props", file=sys.stderr)
        return 3

    decayed, candidates, skipped, split_cands = [], [], 0, []
    for slug, kind, path in iter_source_files(ws):
        if kind != "page":
            continue
        fm, _body, _raw = parse_md(path)
        typ = (fm.get("type") or "").strip()
        # Split-on-growth applies to EVERY page — hub or leaf ("keep every page small"): flag
        # any page whose load would cost more than SPLIT_TOKENS. Size proxy is the .md
        # projection's byte size — what an outl_page_get actually renders — since parse_md's
        # `body` is a thin projection, not the block content. Detection only; the carve (a leaf
        # into child leaves, or an overgrown TOC into grouped sub-TOCs) is the agent's call.
        est_tok = os.path.getsize(path) // CHARS_PER_TOKEN
        if est_tok > SPLIT_TOKENS:
            split_cands.append({"slug": slug, "tokens": est_tok, "type": typ or "?"})
        # Frecency decay + prune-candidate reporting apply only to knowledge leaves.
        if typ != "knowledge":
            continue
        if _truthy(fm.get("pin")):
            skipped += 1
            continue
        if (fm.get("seen") or "") == today:
            skipped += 1
            continue
        old = _int_or_none(fm.get("frecency"))
        old = FRECENCY_SEED if old is None else old
        new = old - 1
        if not dry_run:
            _outl_prop(outl, ws, slug, "frecency", str(new))
            _outl_prop(outl, ws, slug, "seen", today)
        decayed.append({"slug": slug, "from": old, "to": new})
        if new <= 0:
            candidates.append(slug)

    split_cands.sort(key=lambda d: d["tokens"], reverse=True)
    result = {
        "date": today,
        "dry_run": dry_run,
        "decayed": decayed,
        "prune_candidates": candidates,
        "split_candidates": split_cands,
        "skipped": skipped,
    }
    if as_json:
        print(json.dumps(result))
    else:
        tag = " (dry-run)" if dry_run else ""
        print(f"frecency sweep{tag}: decayed {len(decayed)} leaf/leaves, skipped {skipped}")
        for d in decayed:
            print(f"  {d['slug']}: {d['from']} → {d['to']}")
        if candidates:
            print(f"prune candidates (frecency ≤ 0, review per AGENTS.md): {', '.join(candidates)}")
        if split_cands:
            pretty = ", ".join(f"{d['slug']} (~{d['tokens']} tok)" for d in split_cands)
            print(f"split candidates (body > {SPLIT_TOKENS} tok, review per AGENTS.md 'Split on growth'): {pretty}")
    return 0


def cmd_touch(ws: str, slugs, today: str, bump: int, as_json: bool):
    """Credit a material USE of one or more knowledge leaves: frecency += bump (seed 30 if
    unset, saturating at FRECENCY_CAP), seen = today. This is the missing other half of the
    frecency loop — `maintain` decays daily, `touch` reinforces on use — so decay reflects
    real usage instead of relying on the agent to hand-run `outl page prop set`. Writes go
    through outl so the .outl sidecar stays in sync; journals and non-knowledge pages are
    silently skipped (they carry no frecency). Called by the PostToolUse(outl_page_get)
    hook and safe to run by hand."""
    outl = _outl_bin()
    if outl is None:
        print("memory-index touch: outl binary not found; cannot write props", file=sys.stderr)
        return 3
    touched, skipped = [], []
    for slug in slugs:
        path = os.path.join(ws, "pages", f"{slug}.md")
        if not os.path.exists(path):
            skipped.append(slug)
            continue
        fm, _body, _raw = parse_md(path)
        if (fm.get("type") or "").strip() != "knowledge":
            skipped.append(slug)
            continue
        old = _int_or_none(fm.get("frecency"))
        old = FRECENCY_SEED if old is None else old
        new = min(FRECENCY_CAP, old + bump)
        _outl_prop(outl, ws, slug, "frecency", str(new))
        _outl_prop(outl, ws, slug, "seen", today)
        touched.append({"slug": slug, "from": old, "to": new})
    if touched:
        cmd_refresh(ws, None, quiet=True)  # reflect the bumped frontmatter in the index
    result = {"date": today, "bump": bump, "touched": touched, "skipped": skipped}
    if as_json:
        print(json.dumps(result))
    else:
        for t in touched:
            print(f"touch {t['slug']}: {t['from']} → {t['to']}")
        if skipped:
            print(f"skipped (not a knowledge leaf): {', '.join(skipped)}")
    return 0


def _outl_prop(outl: str, ws: str, slug: str, key: str, value: str):
    try:
        subprocess.run(
            [outl, "-w", ws, "page", "prop", "set", slug, f"{key}={value}"],
            check=True,
            capture_output=True,
            timeout=30,
        )
    except Exception as e:  # never let one page fail the whole sweep
        print(f"memory-index maintain: prop set failed for {slug} {key}: {e}", file=sys.stderr)


# ------------------------------------------------ consolidation (journal rollup)
def _aged_journals(ws: str, today: str):
    """Journals beyond the RETENTION_COUNT most recent, by date. The newest 5 dated
    journal files stay in high-resolution memory; every older one is aged out for
    consolidation. `today` is unused (retention is by count, not calendar date)."""
    journals = []
    for path in sorted(glob.glob(os.path.join(ws, "journals", "*.md"))):
        slug = os.path.splitext(os.path.basename(path))[0]
        if DATE_RE.match(slug):
            journals.append((slug, path))
    if len(journals) <= RETENTION_COUNT:
        return []
    return journals[:-RETENTION_COUNT]  # sorted ascending; drop the newest 5


def cmd_consolidate(ws: str, today: str, reap: bool, as_json: bool):
    """Report the consolidation backlog and (optionally) mechanically reap.

    Retention is dead simple and by COUNT: the 5 most recent journals are vivid
    memory and stay; every older ("aged") journal is deleted once it has been
    distilled. An aged journal is bucketed solely by whether the distiller has
    marked it done:
      * reapable   — carries a valid `consolidated:: <date>` mark → the distiller
                     ran, so it is safe to delete; `--reap` does so via
                     `outl page delete`.
      * pending    — no `consolidated::` yet → still to distill.

    NOTE: this deliberately does NOT re-verify that every `distilled-into::` target
    leaf exists and was freshly bumped. That per-leaf `updated:: >= consolidated`
    gate (removed) was the source of a re-queue loop: a correctly-distilled journal
    whose leaf stored `updated::` as a bullet instead of hoisted frontmatter, or a
    leaf that already held the fact and wasn't re-stamped, failed verification —
    so the journal was never deleted, was re-distilled every session, and lingered
    past the 5-journal window. Presence of `consolidated::` (the distiller's last
    action) is the evidence; aged + marked → gone."""
    aged = _aged_journals(ws, today)
    pending, reapable, unverified = [], [], []
    for slug, path in aged:
        fm, _body, _raw = parse_md(path)
        cons = (fm.get("consolidated") or "").strip()
        if DATE_RE.match(cons):
            reapable.append(slug)
        else:
            pending.append(slug)

    reaped = []
    if reap and reapable:
        outl = _outl_bin()
        if outl is None:
            print("memory-index consolidate: outl binary not found; cannot reap", file=sys.stderr)
        else:
            for slug in reapable:
                try:
                    subprocess.run(
                        [outl, "-w", ws, "page", "delete", slug, "--confirm"],
                        check=True, capture_output=True, timeout=30,
                    )
                    reaped.append(slug)
                except Exception as e:
                    print(f"memory-index consolidate: delete failed for {slug}: {e}", file=sys.stderr)
            if reaped:
                cmd_refresh(ws, None, quiet=True)  # drop the deleted journals from the index

    result = {
        "date": today,
        "aged": [s for s, _ in aged],
        "pending": pending,
        "unverified": unverified,
        "reapable": [s for s in reapable if s not in reaped],
        "reaped": reaped,
    }
    if as_json:
        print(json.dumps(result))
    else:
        print(f"consolidation backlog on {today}:")
        print(f"  pending (need distilling): {', '.join(pending) or '(none)'}")
        if unverified:
            print(f"  unverified (marked but distillation unproven — will re-distill): {', '.join(unverified)}")
        print(f"  reapable (distilled+verified, aged): {', '.join(result['reapable']) or '(none)'}")
        if reaped:
            print(f"  reaped now: {', '.join(reaped)}")
    return 0


# ------------------------------------------------------------------------ main
def main(argv=None):
    ap = argparse.ArgumentParser(prog="memory-index", description=__doc__)
    ap.add_argument("-w", "--workspace", default=os.environ.get("MEMORY_WS", WS_DEFAULT))
    ap.add_argument(
        "--threshold",
        type=int,
        default=None,
        help=f"node count at/above which the index is active "
        f"(default: stored value, or {DEFAULT_THRESHOLD})",
    )
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("rebuild")
    sub.add_parser("refresh")
    sp = sub.add_parser("search")
    sp.add_argument("query")
    sp.add_argument("-k", type=int, default=6)
    sp.add_argument("--no-graph", action="store_true")
    sp.add_argument("--json", action="store_true", help="machine-readable results (for hooks)")
    ss = sub.add_parser("stats")
    ss.add_argument("--json", action="store_true")
    st = sub.add_parser("touch", help="credit a use: frecency += bump on the named knowledge leaves")
    st.add_argument("slugs", nargs="+")
    st.add_argument("--bump", type=int, default=FRECENCY_BUMP)
    st.add_argument("--today", default=None, help="override the date (default: today)")
    st.add_argument("--json", action="store_true")
    sm = sub.add_parser("maintain")
    sm.add_argument("--dry-run", action="store_true", help="compute the sweep but write nothing")
    sm.add_argument("--today", default=None, help="override the date (default: today)")
    sm.add_argument("--json", action="store_true")
    sc = sub.add_parser("consolidate")
    sc.add_argument("--reap", action="store_true", help="delete aged journals already marked consolidated::")
    sc.add_argument("--today", default=None, help="override the date (default: today)")
    sc.add_argument("--json", action="store_true")
    sd = sub.add_parser("doctor", help="read-only link-graph health report")
    sd.add_argument("--json", action="store_true")
    smd = sub.add_parser("medic", help="prune pathological edges from the retrieval graph (source untouched)")
    smd.add_argument("--dry-run", action="store_true", help="report what would be pruned; change nothing")
    smd.add_argument("--cap-hubs", type=int, default=None, metavar="N",
                     help="also cap each node's out-edges to the top-N by weight (aggressive)")
    smd.add_argument("--prune-superseded", action="store_true",
                     help="also drop plain refs into superseded pages (aggressive)")
    smd.add_argument("--off", action="store_true", help="disable heals and restore edges from markdown")
    smd.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    ws = os.path.expanduser(args.workspace)
    if not os.path.isdir(ws):
        print(f"memory-index: workspace not found: {ws}", file=sys.stderr)
        return 2

    if args.cmd == "rebuild":
        cmd_rebuild(ws, args.threshold)
    elif args.cmd == "refresh":
        cmd_refresh(ws, args.threshold)
    elif args.cmd == "search":
        cmd_search(ws, args.query, args.k, args.no_graph, args.json)
    elif args.cmd == "stats":
        cmd_stats(ws, args.threshold, args.json)
    elif args.cmd == "touch":
        today = args.today or datetime.date.today().isoformat()
        return cmd_touch(ws, args.slugs, today, args.bump, args.json) or 0
    elif args.cmd == "maintain":
        today = args.today or datetime.date.today().isoformat()
        return cmd_maintain(ws, today, args.dry_run, args.json) or 0
    elif args.cmd == "consolidate":
        today = args.today or datetime.date.today().isoformat()
        return cmd_consolidate(ws, today, args.reap, args.json) or 0
    elif args.cmd == "doctor":
        cmd_doctor(ws, args.json)
    elif args.cmd == "medic":
        cmd_medic(ws, args.dry_run, args.cap_hubs, args.prune_superseded, args.off, args.json)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
