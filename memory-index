# -------------------------------------------------- maintenance (frecency decay)
def _outl_bin() -> str | None:
    cand = os.environ.get("OUTL_BIN") or shutil.which("outl") or "/opt/homebrew/bin/outl"
    return cand if os.path.exists(cand) else shutil.which("outl")


def _truthy(v) -> bool:
    return str(v).strip().lower() in ("true", "1", "yes")


# ---------------------------------------------- section-level frecency (ledger)
# A ws-level JSON ledger {slug: {heading: {"f": frecency, "seen": date}}}. Lives outside
# .outl/ so `rebuild` never wipes it. See the SECTION_* constants for the decay/credit model.
def _sfrec_path(ws: str) -> str:
    return os.path.join(ws, ".frecency", "sections.json")


def _load_sfrec(ws: str) -> dict:
    try:
        with open(_sfrec_path(ws), "r", encoding="utf-8") as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _save_sfrec(ws: str, data: dict):
    path = _sfrec_path(ws)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, separators=(",", ":"), sort_keys=True)
    os.replace(tmp, path)  # atomic


# ---------------------------------------------- outl outline + hierarchy helpers
# The .md is authoritative but outl-managed: mutate ONLY through the outl CLI (block/page
# delete/update) so the op log and block ids stay consistent, then refresh the sqlite index.
_HEAD_RE = re.compile(r"^#{1,6}\s")
_PROP_BULLET_RE = re.compile(r"^[A-Za-z_][\w-]*::\s")


def _outl_outline(outl, ws: str, slug: str):
    """Flat block list for a page via `outl page get --json`. Each entry:
    {id, text, heading, refs, is_head, is_prop}. `heading` is the nearest ancestor
    `## …` section text (or '(top)'); `refs` are [[link]] targets from ref tokens.
    Returns [] on any failure (missing binary/page/parse)."""
    if not outl:
        return []
    try:
        out = subprocess.run(
            [outl, "-w", ws, "page", "get", slug, "--json"],
            capture_output=True, text=True, timeout=30,
        ).stdout
        outline = json.loads(out)["data"]["outline"]
    except Exception:
        return []
    flat = []

    def walk(nodes, heading):
        for n in nodes:
            txt = (n.get("text") or "").strip()
            is_head = bool(_HEAD_RE.match(txt))
            h = txt.lstrip("#").strip() if is_head else heading
            refs = [t.get("value") for t in n.get("tokens", []) if t.get("kind") == "ref"]
            flat.append({
                "id": n.get("id"), "text": txt, "heading": h,
                "refs": [r for r in refs if r],
                "is_head": is_head, "is_prop": bool(_PROP_BULLET_RE.match(txt)),
            })
            walk(n.get("children", []), h)

    walk(outline, "(top)")
    return flat


def _content_blocks(blocks):
    """Trackable body lines: real content bullets, not headings or frontmatter props."""
    return [b for b in blocks if b["id"] and not b["is_head"] and not b["is_prop"] and b["text"]]


def _part_of_maps(con):
    """(parent_of, children_of) from the derived `part-of` edges (src=child, dst=parent).
    Authoritative for hierarchy regardless of whether `parent::` is hoisted to frontmatter
    or authored as a body bullet — the edge is built from either."""
    parent_of, children_of = {}, {}
    for src, dst in con.execute("SELECT src, dst FROM edges WHERE type='part-of'"):
        parent_of.setdefault(src, dst)
        children_of.setdefault(dst, set()).add(src)
    return parent_of, children_of


def _ancestors(parent_of: dict, slug: str):
    """Parent slugs from `slug` up to root, via the part-of map. Cycle-guarded."""
    chain, seen, cur = [], {slug}, slug
    while True:
        p = parent_of.get(cur)
        if not p or p in seen:
            break
        seen.add(p)
        chain.append(p)
        cur = p
    return chain


def _bump_page(outl, ws: str, slug: str, bump: int, today: str):
    """frecency += bump (seed FRECENCY_SEED if unset, cap FRECENCY_CAP), seen=today.
    Returns (old, new) or None if the page is missing/unreadable."""
    path = os.path.join(ws, "pages", f"{slug}.md")
    if not os.path.exists(path):
        return None
    try:
        fm, _b, _r = parse_md(path)
    except Exception:
        return None
    old = _int_or_none(fm.get("frecency"))
    old = FRECENCY_SEED if old is None else old
    new = min(FRECENCY_CAP, old + bump)
    _outl_prop(outl, ws, slug, "frecency", str(new))
    _outl_prop(outl, ws, slug, "seen", today)
    return (old, new)


def _bump_blocks(sfrec: dict, slug: str, block_ids, amount: int, today: str):
    """Credit content blocks by id: f += amount (seed SECTION_SEED, cap SECTION_CAP),
    seen=today. Mutates sfrec in place."""
    page = sfrec.setdefault(slug, {})
    for bid in block_ids:
        rec = page.get(bid) or {"f": SECTION_SEED, "seen": ""}
        rec["f"] = min(SECTION_CAP, int(rec.get("f", SECTION_SEED)) + amount)
        rec["seen"] = today
        page[bid] = rec


_REF_PAT_CACHE: dict = {}


def _strip_ref(text: str, target: str) -> str:
    pat = _REF_PAT_CACHE.get(target)
    if pat is None:
        pat = re.compile(r"\[\[" + re.escape(target) + r"(?:\|[^\]]*)?\]\]")
        _REF_PAT_CACHE[target] = pat
    t = pat.sub("", text)
    t = re.sub(r"\s{2,}", " ", t)
    t = re.sub(r"(^\s*[—–-]\s*|\s*[—–-]\s*$)", "", t)
    return t.strip()


def _outl_run(outl, ws: str, args) -> bool:
    try:
        subprocess.run([outl, "-w", ws] + args, check=True, capture_output=True, timeout=30)
        return True
    except Exception as e:
        print(f"memory-index maintain: outl {' '.join(args[:2])} failed: {e}", file=sys.stderr)
        return False


def _evict_page(outl, ws, slug):
    return _outl_run(outl, ws, ["page", "delete", slug, "--confirm"])


def _evict_block(outl, ws, bid):
    return _outl_run(outl, ws, ["block", "delete", bid, "--confirm"])


def _scrub_ref_block(outl, ws, block, dead):
    """Remove [[dead…]] refs from one surviving block. Delete the block outright when it
    was a pointer entry (led with the ref, nothing meaningful left); else rewrite its text."""
    text = block["text"]
    new = text
    for d in dead:
        new = _strip_ref(new, d)
    still_links = "[[" in new
    leads_with_ref = text.lstrip().startswith("[[")
    if not re.search(r"[A-Za-z0-9]", new) or (leads_with_ref and not still_links):
        _evict_block(outl, ws, block["id"])
    else:
        _outl_run(outl, ws, ["block", "update", block["id"], "--text", new])


def cmd_maintain(ws: str, today: str, dry_run: bool, as_json: bool):
    """Daily frecency sweep + silent, mechanical eviction. Frecency is the SOLE retention
    metric for this decay-cache memory: every page (leaf AND moc) and every content block
    decays −1/day unless credited today; `touch`/`search --credit` reinforce on use and
    propagate up the parent chain. Anything reaching 0 is FORGOTTEN — no prompt, no message:
      * content block → 0 : delete just that block (the file stays).
      * knowledge leaf → 0: soft-trash the page; scrub [[it]] from every survivor; parent stays.
      * moc/toc → 0       : soft-trash the moc AND its whole subtree; scrub inbound refs.
    All mutations go through outl (page/block delete/update); the sqlite index is refreshed
    after. `--dry-run` writes nothing and only reports (used for split-candidate discovery)."""
    outl = _outl_bin()
    if outl is None and not dry_run:
        print("memory-index maintain: outl binary not found; cannot evict", file=sys.stderr)
        return 3

    sfrec = _load_sfrec(ws)
    decayed, split_cands = [], []
    dead: list[str] = []                  # pages that reached frecency 0 this sweep
    block_evict: dict[str, set] = {}
    all_blocks: dict[str, list] = {}

    con = _open_current(ws)
    _parent_of, child_map = _part_of_maps(con)
    con.close()

    pages = []
    page_slugs: set = set()
    for slug, kind, path in iter_source_files(ws):
        if kind != "page":            # journals have their own retention/consolidation path
            continue
        try:
            fm, body, _raw = parse_md(path)
        except Exception:
            continue
        typ = (fm.get("type") or "").strip()
        pages.append((slug, path, fm, typ))
        page_slugs.add(slug)

    for slug, path, fm, typ in pages:
        est_tok = os.path.getsize(path) // CHARS_PER_TOKEN
        if est_tok > SPLIT_TOKENS:
            split_cands.append({"slug": slug, "tokens": est_tok, "type": typ or "?"})

        # Page-level decay: EVERY page (leaf or moc), no pin exemption. Once/day (seen guard).
        if (fm.get("seen") or "") != today:
            old = _int_or_none(fm.get("frecency"))
            old = FRECENCY_SEED if old is None else old
            new = old - 1
            if not dry_run:
                _outl_prop(outl, ws, slug, "frecency", str(new))
                _outl_prop(outl, ws, slug, "seen", today)
            decayed.append({"slug": slug, "from": old, "to": new})
            if new <= 0:
                dead.append(slug)

        # Block-level decay (real content lines only). Read-only outl calls, skipped in dry-run.
        if not dry_run and outl:
            blocks = _outl_outline(outl, ws, slug)
            all_blocks[slug] = blocks
            page_led = sfrec.setdefault(slug, {})
            live_ids = set()
            for b in _content_blocks(blocks):
                live_ids.add(b["id"])
                rec = page_led.get(b["id"]) or {"f": SECTION_SEED, "seen": ""}
                if rec.get("seen") == today:
                    page_led[b["id"]] = rec
                    continue
                rec["f"] = int(rec.get("f", SECTION_SEED)) - 1
                rec["seen"] = today
                page_led[b["id"]] = rec
                if rec["f"] <= SECTION_PRUNE:
                    block_evict.setdefault(slug, set()).add(b["id"])
            for bid in list(page_led.keys()):  # GC ledger ids no longer present in the page
                if bid not in live_ids:
                    del page_led[bid]

    # A dead page takes its whole subtree with it (a moc == a page with children). Upward
    # credit propagation guarantees a page only reaches 0 once its entire subtree is cold, so
    # the cascade is safe. Journals are excluded (retention/consolidation own their lifecycle).
    dead_set: set = set()
    stack = list(dead)
    while stack:
        x = stack.pop()
        if x in dead_set:
            continue
        dead_set.add(x)
        stack.extend(child_map.get(x, ()))
    dead_set &= page_slugs

    evicted_pages, evicted_blocks = [], []
    if not dry_run and outl:
        # 1) scrub inbound refs to any dead slug from SURVIVOR blocks (no dangling links left)
        if dead_set:
            for slug, path, fm, typ in pages:
                if slug in dead_set:
                    continue
                for b in all_blocks.get(slug, []):
                    if b["is_prop"] or not b["id"]:
                        continue
                    hits = [d for d in b["refs"] if d in dead_set]
                    if hits:
                        _scrub_ref_block(outl, ws, b, hits)
        # 2) soft-trash every dead page (leaf, or moc + its whole subtree)
        for slug in dead_set:
            if _evict_page(outl, ws, slug):
                evicted_pages.append(slug)
            sfrec.pop(slug, None)
        # 3) line-level: delete dead content blocks on surviving pages
        for slug, ids in block_evict.items():
            if slug in dead_set:
                continue
            for bid in ids:
                if _evict_block(outl, ws, bid):
                    evicted_blocks.append(f"{slug}:{bid}")
                sfrec.get(slug, {}).pop(bid, None)

    if not dry_run:
        _save_sfrec(ws, sfrec)
        if evicted_pages or evicted_blocks:
            cmd_refresh(ws, None, quiet=True)

    split_cands.sort(key=lambda d: d["tokens"], reverse=True)
    result = {
        "date": today,
        "dry_run": dry_run,
        "decayed": decayed,
        "evicted_pages": evicted_pages,
        "evicted_blocks": evicted_blocks,
        "split_candidates": split_cands,
    }
    if as_json:
        print(json.dumps(result))
    return 0


def cmd_touch(ws: str, slugs, today: str, bump: int, as_json: bool):
    """Credit a material USE and keep the whole access PATH warm. Bumps the page's frecency,
    its content blocks, AND every ancestor moc/toc up the `parent::` chain (using a memory
    means using the index that led to it — so an index never dies while a memory reached
    through it stays live). Decay's counterpart: `maintain` −1/day, `touch` reinforces on use.
    Any page type is eligible (leaf or moc); missing pages are skipped. Called by the
    PostToolUse(outl_page_get) hook and safe to run by hand."""
    outl = _outl_bin()
    if outl is None:
        print("memory-index touch: outl binary not found; cannot write props", file=sys.stderr)
        return 3
    touched, skipped = [], []
    sfrec = _load_sfrec(ws)
    sfrec_dirty = False
    bumped: set = set()
    con = _open_current(ws)
    parent_of, _children = _part_of_maps(con)
    con.close()
    for slug in slugs:
        r = _bump_page(outl, ws, slug, bump, today)
        if r is None:
            skipped.append(slug)
            continue
        bumped.add(slug)
        touched.append({"slug": slug, "from": r[0], "to": r[1]})
        # Whole-page fetch is weak per-block evidence: bump every content line a little. A
        # search HIT credits the matched lines more precisely (see cmd_search --credit).
        content = _content_blocks(_outl_outline(outl, ws, slug))
        if content:
            _bump_blocks(sfrec, slug, [b["id"] for b in content], SECTION_PAGEGET_BUMP, today)
            sfrec_dirty = True
        # Keep the pathway warm: propagate the bump up the parent chain to the root index.
        for anc in _ancestors(parent_of, slug):
            if anc in bumped:
                continue
            ar = _bump_page(outl, ws, anc, bump, today)
            if ar is not None:
                bumped.add(anc)
                touched.append({"slug": anc, "from": ar[0], "to": ar[1], "via": slug})
    if sfrec_dirty:
        _save_sfrec(ws, sfrec)
    if touched:
        cmd_refresh(ws, None, quiet=True)  # reflect the bumped frontmatter in the index
    result = {"date": today, "bump": bump, "touched": touched, "skipped": skipped}
    if as_json:
        print(json.dumps(result))
    else:
        for t in touched:
            via = f"  (via {t['via']})" if t.get("via") else ""
            print(f"touch {t['slug']}: {t['from']} → {t['to']}{via}")
        if skipped:
            print(f"skipped (missing page): {', '.join(skipped)}")
    return 0


def _outl_prop(outl: str, ws: str, slug: str, key: str, value: str):
    try:
        subprocess.run(
            [outl, "-w", ws, "page", "prop", "set", slug, f"{key}={value}"],
            check=True,
            capture_output=True,
            timeout=30,
        )
    except Exception as e:  # never let one page fail the whole sweep
        print(f"memory-index maintain: prop set failed for {slug} {key}: {e}", file=sys.stderr)


# ------------------------------------------------ consolidation (journal rollup)
def _aged_journals(ws: str, today: str):
    """Journals beyond the RETENTION_COUNT most recent, by date. The newest 5 dated
    journal files stay in high-resolution memory; every older one is aged out for
    consolidation. `today` is unused (retention is by count, not calendar date)."""
    journals = []
    for path in sorted(glob.glob(os.path.join(ws, "journals", "*.md"))):
        slug = os.path.splitext(os.path.basename(path))[0]
        if DATE_RE.match(slug):
            journals.append((slug, path))
    if len(journals) <= RETENTION_COUNT:
        return []
    return journals[:-RETENTION_COUNT]  # sorted ascending; drop the newest 5


def cmd_consolidate(ws: str, today: str, reap: bool, as_json: bool):
    """Report the consolidation backlog and (optionally) mechanically reap.

    Retention is by COUNT: the 5 most recent journals stay; every older ("aged")
    journal is deleted once it has been distilled. An aged journal is bucketed solely
    by whether the distiller has marked it done:
      * reapable   — carries a valid `consolidated:: <date>` mark → safe to delete;
                     `--reap` does so via `outl page delete`.
      * pending    — no `consolidated::` yet → still to distill.

    Bucketing is on the presence of `consolidated::` alone; it does NOT re-verify that
    every `distilled-into::` target leaf exists and was freshly bumped."""
    aged = _aged_journals(ws, today)
    pending, reapable, unverified = [], [], []
    for slug, path in aged:
        fm, _body, _raw = parse_md(path)
        cons = (fm.get("consolidated") or "").strip()
        if DATE_RE.match(cons):
            reapable.append(slug)
        else:
            pending.append(slug)

    reaped = []
    if reap and reapable:
        outl = _outl_bin()
        if outl is None:
            print("memory-index consolidate: outl binary not found; cannot reap", file=sys.stderr)
        else:
            for slug in reapable:
                try:
                    subprocess.run(
                        [outl, "-w", ws, "page", "delete", slug, "--confirm"],
                        check=True, capture_output=True, timeout=30,
                    )
                    reaped.append(slug)
                except Exception as e:
                    print(f"memory-index consolidate: delete failed for {slug}: {e}", file=sys.stderr)
            if reaped:
                cmd_refresh(ws, None, quiet=True)  # drop the deleted journals from the index

    result = {
        "date": today,
        "aged": [s for s, _ in aged],
        "pending": pending,
        "unverified": unverified,
        "reapable": [s for s in reapable if s not in reaped],
        "reaped": reaped,
    }
    if as_json:
        print(json.dumps(result))
    else:
        print(f"consolidation backlog on {today}:")
        print(f"  pending (need distilling): {', '.join(pending) or '(none)'}")
        if unverified:
            print(f"  unverified (marked but distillation unproven — will re-distill): {', '.join(unverified)}")
        print(f"  reapable (distilled+verified, aged): {', '.join(result['reapable']) or '(none)'}")
        if reaped:
            print(f"  reaped now: {', '.join(reaped)}")
    return 0


# ------------------------------------------------------------------------ main
def main(argv=None):
    ap = argparse.ArgumentParser(prog="memory-index", description=__doc__)
    ap.add_argument("-w", "--workspace", default=os.environ.get("MEMORY_WS", WS_DEFAULT))
    ap.add_argument(
        "--threshold",
        type=int,
        default=None,
        help=f"node count at/above which the index is active "
        f"(default: stored value, or {DEFAULT_THRESHOLD})",
    )
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("rebuild")
    sub.add_parser("refresh")
    sp = sub.add_parser("search")
    sp.add_argument("query")
    sp.add_argument("-k", type=int, default=6)
    sp.add_argument("--no-graph", action="store_true")
    sp.add_argument("--json", action="store_true", help="machine-readable results (for hooks)")
    sp.add_argument("--credit", action="store_true",
                    help="credit section frecency for each keyword hit's section (for the push hook)")
    ss = sub.add_parser("stats")
    ss.add_argument("--json", action="store_true")
    st = sub.add_parser("touch", help="credit a use: frecency += bump on the named knowledge leaves")
    st.add_argument("slugs", nargs="+")
    st.add_argument("--bump", type=int, default=FRECENCY_BUMP)
    st.add_argument("--today", default=None, help="override the date (default: today)")
    st.add_argument("--json", action="store_true")
    sm = sub.add_parser("maintain")
    sm.add_argument("--dry-run", action="store_true", help="compute the sweep but write nothing")
    sm.add_argument("--today", default=None, help="override the date (default: today)")
    sm.add_argument("--json", action="store_true")
    sc = sub.add_parser("consolidate")
    sc.add_argument("--reap", action="store_true", help="delete aged journals already marked consolidated::")
    sc.add_argument("--today", default=None, help="override the date (default: today)")
    sc.add_argument("--json", action="store_true")
    sd = sub.add_parser("doctor", help="read-only link-graph health report")
    sd.add_argument("--json", action="store_true")
    smd = sub.add_parser("medic", help="prune pathological edges from the retrieval graph (source untouched)")
    smd.add_argument("--dry-run", action="store_true", help="report what would be pruned; change nothing")
    smd.add_argument("--cap-hubs", type=int, default=None, metavar="N",
                     help="also cap each node's out-edges to the top-N by weight (aggressive)")
    smd.add_argument("--prune-superseded", action="store_true",
                     help="also drop plain refs into superseded pages (aggressive)")
    smd.add_argument("--off", action="store_true", help="disable heals and restore edges from markdown")
    smd.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    ws = os.path.expanduser(args.workspace)
    if not os.path.isdir(ws):
        print(f"memory-index: workspace not found: {ws}", file=sys.stderr)
        return 2

    if args.cmd == "rebuild":
        cmd_rebuild(ws, args.threshold)
    elif args.cmd == "refresh":
        cmd_refresh(ws, args.threshold)
    elif args.cmd == "search":
        cmd_search(ws, args.query, args.k, args.no_graph, args.json, args.credit)
    elif args.cmd == "stats":
        cmd_stats(ws, args.threshold, args.json)
    elif args.cmd == "touch":
        today = args.today or datetime.date.today().isoformat()
        return cmd_touch(ws, args.slugs, today, args.bump, args.json) or 0
    elif args.cmd == "maintain":
        today = args.today or datetime.date.today().isoformat()
        return cmd_maintain(ws, today, args.dry_run, args.json) or 0
    elif args.cmd == "consolidate":
        today = args.today or datetime.date.today().isoformat()
        return cmd_consolidate(ws, today, args.reap, args.json) or 0
    elif args.cmd == "doctor":
        cmd_doctor(ws, args.json)
    elif args.cmd == "medic":
        cmd_medic(ws, args.dry_run, args.cap_hubs, args.prune_superseded, args.off, args.json)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
