#!/usr/bin/env bash
#
# memory-consolidate — automatic, headless compaction of the memory graph.
#
# One headless agent handles three backlogs in a single pass:
#   * journals — distil aged, un-`consolidated::` journals into knowledge leaves,
#     mark each `consolidated:: <today>`, then reap (delete) the marked ones.
#   * split    — carve a `type:: knowledge` leaf grown past the load budget
#     (MEMORY_SPLIT_TOKENS) into a TOC + `<slug>-<section>` child leaves.
#   * prune    — delete (soft/recoverable) a leaf whose frecency decayed to 0,
#     after cleaning up its parent-TOC link, or bump it if it still earns a place.
# Reaping and candidate detection are mechanical (`memory-index`); the distil,
# split, and keep-vs-delete calls need an LLM, so this spawns a detached, headless
# `claude -p` agent per ~/.claude/memory/AGENTS.md. The SessionStart hook backgrounds
# this whenever any backlog exists.
#
# Safe to run any time and repeatedly: it no-ops when nothing is pending,
# single-instances via a lock, and refuses to recurse into the agent it spawns.

set -u

MEMIDX="${MEMORY_INDEX_BIN:-$HOME/.local/bin/memory-index}"
OUTL="${OUTL_BIN:-/opt/homebrew/bin/outl}"
CLAUDE="${CLAUDE_BIN:-claude}"
# Hooks can run with a minimal PATH; fall back to the usual install location.
command -v "$CLAUDE" >/dev/null 2>&1 || CLAUDE="$HOME/.local/bin/claude"
# Distillation runs on a capable model. Override with MEMORY_MODEL.
MODEL="${MEMORY_MODEL:-claude-sonnet-5}"
WS="${MEMORY_WS:-$HOME/.claude/memory}"   # override targets an isolated workspace (tests)
LOCKDIR="$WS/.consolidate.lock.d"
LOG="$WS/.consolidate.log"
TODAY="$(date +%F)"

# Never recurse: the spawned agent's own session must not relaunch us. The hook guards this too.
[ -n "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && exit 0

[ -x "$MEMIDX" ] || exit 0

# Single instance (portable, no flock — macOS has none). mkdir is atomic; clear a
# stale lock left by a crashed run (>60 min old) before trying.
if [ -d "$LOCKDIR" ] && [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
  rmdir "$LOCKDIR" 2>/dev/null || true
fi
mkdir "$LOCKDIR" 2>/dev/null || exit 0
trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT

pending() {
  "$MEMIDX" -w "$WS" consolidate --json 2>/dev/null | python3 -c 'import sys, json
try:
    print(" ".join(json.load(sys.stdin).get("pending", [])))
except Exception:
    print("")' 2>/dev/null
}

pend="$(pending)"

# Split candidates only. All pruning/eviction is now MECHANICAL and SILENT in
# `memory-index maintain` (frecency 0 -> forgotten, no LLM); the agent handles only the two
# generative jobs left — distilling journals and splitting oversized pages. The SessionStart
# hook passes the authoritative sweep JSON via MEMORY_CONSOLIDATE_SWEEP; standalone, fall back
# to a dry-run sweep (read-only, so it never double-decays).
sweep="${MEMORY_CONSOLIDATE_SWEEP:-}"
[ -z "$sweep" ] && sweep="$("$MEMIDX" -w "$WS" maintain --dry-run --json 2>/dev/null)"
split_slugs="$(printf '%s' "$sweep" | python3 -c 'import sys, json
try:
    c = json.load(sys.stdin).get("split_candidates", [])
except Exception:
    c = []
print(" ".join(d["slug"] if isinstance(d, dict) else d for d in c))' 2>/dev/null)"

# Nothing to do at all — still reap anything already marked, then done.
if [ -z "$pend" ] && [ -z "$split_slugs" ]; then
  "$MEMIDX" -w "$WS" consolidate --reap >/dev/null 2>&1 || true
  exit 0
fi

# LLM work below needs the CLI. If absent, reap what's marked and leave the rest to the hook's fallback.
if ! command -v "$CLAUDE" >/dev/null 2>&1; then
  "$MEMIDX" -w "$WS" consolidate --reap >/dev/null 2>&1 || true
  exit 0
fi

# Build the task list from whichever backlogs are non-empty: distilling aged journals and
# splitting oversized pages. Pruning is mechanical and lives in `memory-index maintain`.
tasks=""
[ -n "$pend" ] && tasks="${tasks}
JOURNALS — distill these aged journals (older than the 5 most recent, not yet consolidated): $pend
  Follow the Condensation section of AGENTS.md exactly. For EACH date: (1) outl_daily_get and read it; (2) cluster items by the [[page]]/topic they concern — an item already marked #in-deep [[leaf]] was written through when authored, so do NOT re-merge it, just verify the leaf still carries it and list that leaf in the date's distilled-into evidence; (3) tier every remaining cluster: DROP ephemeral git/branch/working-tree/status/session-local notes outright, promote-or-drop borderline items DELIBERATELY, and for each lasting cluster (cross-repo relationships, plan state, decisions+why, gotchas, durable user facts — but not what the repo/git/CLAUDE.md already holds) descend to the right knowledge leaf (create a leaf or split a crowded TOC as needed) and merge the DISTILLED points (synthesise, never paste, never duplicate a point already there); refresh updated::/summary::, ensure project::/parent:: and back-links, touch frecency (new leaf seeds frecency:: 30; a merge is +5 capped 60) and set seen:: $TODAY; (4) add any new leaf/TOC's one-line [[link]]+hook to its parent TOC (and to index for a new top-level topic); (5) as the LAST actions for that date, record evidence then mark done: outl_page_prop_set <date> distilled-into=\"[[a]] [[b]]\" (every leaf merged into; =none if nothing durable), then outl_page_prop_set <date> consolidated=$TODAY. Do NOT delete journals — reaping is automatic once consolidated:: is set. Finally refresh index: bump updated:: and trim Recent journals to the retention window."
[ -n "$split_slugs" ] && tasks="${tasks}
PAGES TO SPLIT (any page — a content leaf OR a TOC/hub — whose body now costs more than the load budget to read): $split_slugs
  For EACH, follow the 'Split on growth' rule in AGENTS.md, so that NO page stays oversized and the graph is still navigable in a few hops:
   - A content LEAF (type:: knowledge): carve its sections into child leaf documents named <slug>-<section>, move the DETAIL down into those children, and leave in the (now type:: moc) parent one concise one-line [[link]]+hook per child. Give each child full leaf frontmatter (type:: knowledge, project::, parent:: [[the new toc]], updated:: $TODAY, summary::, frecency:: 30, seen:: $TODAY).
   - A HUB (type:: moc) that has grown too big: group its child entries into a few coherent sub-topics, create a sub-TOC (type:: moc, named <slug>-<group>) for each group, move those entries' [[link]]s+hooks down into the matching sub-TOC, and leave in the parent one [[link]]+hook per sub-TOC. The parent stays a thin index OF sub-TOCs; set parent:: on each new sub-TOC and keep every back-link intact.
  Either way: preserve every fact and every crosslink (no dangling links, no orphans), and re-point the page's own parent-TOC entry if its role changed. If a page genuinely has no clean split seam, LEAVE it and say so."
prompt="You are running headless as the memory-system compaction agent. Do ONLY the tasks below, then stop — ignore everything else. Work entirely within the outl memory graph at ~/.claude/memory; do NOT touch code, git, or anything outside it. Read the named sections of ~/.claude/memory/AGENTS.md and follow them exactly. Do NOT prune, delete, or bump the frecency of any page or section — decay and eviction are handled mechanically elsewhere; touching them here would corrupt the retention signal.
$tasks

Priorities, in order: (1) never lose a durable fact while distilling; (2) keep the graph navigable — every page reachable from its parent TOC by a one-hop [[link]], no dangling links, no orphans; (3) keep every page small. Work silently.

When writing multiple blocks under the same section, batch with outl_batch or outl_block_append_tree instead of one outl_block_append call per item. Never write a bare '#272' for a PR/issue — use '[#272](url)' or 'PR 272'. Prefer outl_page_render over outl_page_get when you only need to read a page's rendered content, not edit it."

# Point the distiller's outl MCP at THIS workspace explicitly (so it operates on the
# workspace we manage, not whatever ambient config happens to serve) and strict-scope it so
# no unrelated MCP servers load. This is what also lets the test harness run the real
# distiller against an isolated fixture via MEMORY_WS.
_MCP_CFG="$(mktemp)"
printf '{"mcpServers":{"outl":{"command":"%s","args":["mcp","serve","-w","%s"]}}}' "$OUTL" "$WS" > "$_MCP_CFG"
MEMORY_CONSOLIDATE_ACTIVE=1 "$CLAUDE" -p "$prompt" \
  --model "$MODEL" \
  --mcp-config "$_MCP_CFG" \
  --strict-mcp-config \
  --dangerously-skip-permissions \
  >>"$LOG" 2>&1 || true
rm -f "$_MCP_CFG"

# Reap journals the agent marked consolidated::, then reindex the restructured tree.
"$MEMIDX" -w "$WS" consolidate --reap >>"$LOG" 2>&1 || true
"$MEMIDX" -w "$WS" refresh >>"$LOG" 2>&1 || true
exit 0
