#!/usr/bin/env bash
#
# memory-dump — on session close, record the session's DURABLE facts via a
# detached, headless agent. Fired by the SessionEnd branch of memory-hook,
# which passes the transcript path.
#
# Follows the two-tier write policy (see ~/.llm-harness-memory/AGENTS.md): every durable
# fact lands in today's journal, and IMPACTFUL facts (ones that make a knowledge
# page wrong, reverse a prior decision, or add a new component / cross-project
# relationship / durable user fact) are additionally written through to the right
# deep-memory leaf, merged and back-marked #in-deep in the journal. Runs headless via
# `memory-agent` on the harness that fired the hook (MEMORY_HARNESS), on that harness's memory
# model (see `memory-agent --get-model`; Sonnet 5 by default). The agent reads the transcript,
# extracts what is worth remembering across sessions, and writes it via the outl MCP
# tools, deduping and never rewriting or deleting existing entries.
#
# Safe to run any time: it no-ops on a trivial/absent transcript, queues the transcript and
# single-instances via a lock (a dump already running drains the queue, so a session that ends
# meanwhile is journaled after it rather than dropped), and refuses to recurse into the agent
# it spawns.

set -u

AGENT="${MEMORY_AGENT_BIN:-$(dirname "${BASH_SOURCE[0]}")/memory-agent}"
HARNESS="${MEMORY_HARNESS:-claude}"
WS="${MEMORY_WS:-$HOME/.llm-harness-memory}"   # override targets an isolated workspace (tests)
LOCKDIR="$WS/.dump.lock.d"
QUEUE="$WS/.dump-queue"
LOG="$WS/.dump.log"
MIN_LINES="${MEMORY_DUMP_MIN_LINES:-8}"   # skip trivial sessions
TRANSCRIPT="${MEMORY_DUMP_TRANSCRIPT:-${1:-}}"

# Never recurse: the spawned agent's SessionEnd must not refire this. The hook guards this too.
[ -n "${MEMORY_DUMP_ACTIVE:-}" ] && exit 0
[ -n "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && exit 0

# Need a real transcript, a memory workspace, and a headless agent CLI.
[ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ] || exit 0
[ -d "$WS" ] || exit 0
[ -x "$AGENT" ] && "$AGENT" --available || exit 0

# Skip trivial sessions; line count proxies meaningful work.
lines="$(wc -l < "$TRANSCRIPT" 2>/dev/null | tr -d ' ')"
case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
[ "$lines" -ge "$MIN_LINES" ] || exit 0

# Queue first, then drain under the single-instance lock below.
mkdir -p "$QUEUE" && printf '%s\n' "$TRANSCRIPT" > "$QUEUE/$(date +%s).$$" || exit 0

# dump_one <transcript>  — one headless journaler run over one transcript.
dump_one() {
  local transcript="$1" prompt
prompt="You are running headless as the memory-system session journaler. Do ONLY the task below, then stop — ignore everything else.

A coding-agent session ($HARNESS) just ended. Its full transcript (JSONL, one record per line) is at:
  $transcript

Read that transcript, then record the session's DURABLE facts via the outl MCP tools, following the 'Two-tier writes', 'Writing to memory', 'What long-term memory is for', and 'Condensation' sections of ~/.llm-harness-memory/AGENTS.md.

Rules:
  1. FIRST call outl_daily_today to read today's journal. It may already contain entries the interactive agent wrote at checkpoints — you are ADDING to it, not replacing it.
  2. Extract ONLY what is worth remembering across sessions: decisions + their why, discoveries/gotchas, long-running plan state, cross-repo relationships, durable user facts. DROP chit-chat, transient tool output, and anything the code / its git log / its CLAUDE.md or AGENTS.md already records.
  3. Append each new fact as a CHILD BULLET under the matching ## section that already exists in today's journal. The journal template lays the sections down (normally ## Focus / ## Key Decisions / ## Discoveries / ## Action Items / ## Session Notes); use the sections today's journal actually has and never add one. To append: from the outline you read in step 1, take the block id of the matching ## Section, then call outl_block_append with parent = that block id and text = just the bullet, with NO '## ' header inside the text. Do NOT use outl_daily_append for section content — it appends a FLAT top-level block and cannot nest, so it produces duplicate '## Focus'/'## Discoveries' headers and unsectioned bullets. NEVER emit a '## Section' header that already exists. Link each bullet outward to the [[project-...]] or [[topic]] it concerns. Be concise — one bullet per fact.
  4. Do NOT duplicate anything already in today's journal — compare against what you read in step 1 and add only what is missing. Skip any item already marked #in-deep (it is already in deep memory).
  5. TIER each durable fact and act accordingly:
     - IMPACTFUL — a fact that (a) makes a current knowledge page inaccurate or incomplete, (b) reverses or supersedes a prior durable decision, or (c) introduces a new architectural component, cross-project relationship, or durable user fact — must be WRITTEN THROUGH to deep memory now, not left in the journal. Procedure: descend from the injected index / TOC to the target knowledge leaf (outl_page_get it; create a new leaf under the right TOC, splitting a crowded one, only if none fits); MERGE the distilled fact by editing or appending to that leaf — synthesise, do not paste, and never duplicate a point it already states; refresh its properties (updated to today; summary if it changed; ensure parent, project, and back-links; frecency +5 capped at 60, or seed 30 for a new leaf; seen to today); if a new leaf or TOC, add its one-line [[link]] + hook to the parent TOC (and the parent to index if it is a new top-level topic). THEN mark the journal breadcrumb for that fact with a trailing  #in-deep [[target-leaf]]  so condensation verifies rather than re-merges it.
     - EPHEMERAL — transient git/branch/working-tree state, currently-doing status, session-local notes — goes in the journal ONLY. Never write it to a leaf.
     - Everything else — journal only; condensation promotes or drops it later.
  6. EDIT-MERGE, NEVER CLOBBER. Always read a page (outl_page_get) before you write to it, and ADD to it. NEVER delete, rewrite, or reword an existing journal entry or existing leaf content. Whenever you change a page body, bump its updated to today. (An autonomous agent that pastes instead of merging duplicates pages — do not.)
  7. If the session produced nothing durable, do nothing at all.
  8. Do NOT touch code, git, or anything outside the memory graph."

  # Scope the journaler's outl MCP to THIS workspace (not whatever ambient config serves).
  MEMORY_DUMP_ACTIVE=1 "$AGENT" --ws "$WS" "$prompt" >>"$LOG" 2>&1 || true
}

# Drain the queue under a single-instance lock (portable, no flock; mkdir is atomic). A stale
# lock from a crashed run (>60 min old) is cleared first. After releasing, re-check: a session
# that queued after the last pass saw the lock held and left its job to us.
while :; do
  if [ -d "$LOCKDIR" ] && [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
    rmdir "$LOCKDIR" 2>/dev/null || true
  fi
  mkdir "$LOCKDIR" 2>/dev/null || exit 0
  trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT
  for job in "$QUEUE"/*; do
    [ -f "$job" ] || continue
    t="$(cat "$job" 2>/dev/null)"
    rm -f "$job"
    [ -n "$t" ] && [ -f "$t" ] && dump_one "$t"
  done
  rmdir "$LOCKDIR" 2>/dev/null
  trap - EXIT
  [ -n "$(ls -A "$QUEUE" 2>/dev/null)" ] || exit 0
done
