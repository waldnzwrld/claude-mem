#!/usr/bin/env bash
#
# Claude Code persistent-memory hook.
#   SessionStart -> inject the memory index (TOC) + recent journals as context,
#                   and, on the first session of a new day, flag journals that
#                   have aged out of the retention window for condensation.
#   PreCompact   -> best-effort reminder to flush unsaved notes to the journal
#                   before the context is compacted.
#
# Reads the hook JSON on stdin, writes a hookSpecificOutput JSON on stdout.
# Wired via ~/.claude/settings.json. Designed to never fail a session (exit 0).
# See ~/.claude/memory/AGENTS.md for the protocol this supports.

OUTL="${OUTL_BIN:-/opt/homebrew/bin/outl}"
MEMIDX="${MEMORY_INDEX_BIN:-$HOME/.local/bin/memory-index}"
CONS="${MEMORY_CONSOLIDATE_BIN:-$HOME/.local/bin/memory-consolidate}"
DUMP="${MEMORY_DUMP_BIN:-$HOME/.local/bin/claude-memory-dump}"
CLAUDE="${CLAUDE_BIN:-claude}"
# Hooks can run with a minimal PATH; fall back to the usual install location.
command -v "$CLAUDE" >/dev/null 2>&1 || CLAUDE="$HOME/.local/bin/claude"
WS="$HOME/.claude/memory"
MARKER="$WS/.last-session-date"
ATTEMPTS="$WS/.consolidate-attempts"    # per-journal count of consecutive auto-consolidation attempts
MAX_CONSOLIDATE_ATTEMPTS=2              # auto-retry a stuck journal this many times, then surface it
TODAY="$(date +%F)"

input="$(cat)"
event="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    print(json.load(sys.stdin).get("hook_event_name", ""))
except Exception:
    print("")' 2>/dev/null)"

# emit <hookEventName>  (context text taken from $CTX)
# additionalContext is the supported channel for SessionStart; use it there only.
emit() {
  python3 -c 'import json, os, sys
print(json.dumps({"hookSpecificOutput": {"hookEventName": sys.argv[1], "additionalContext": os.environ.get("CTX", "")}}))' "$1"
}

# emit_msg <text>  — surface a message to the model via the top-level systemMessage
# field. PreCompact does NOT honour additionalContext, so its reminder must go
# through systemMessage or it is silently dropped.
emit_msg() {
  python3 -c 'import json, sys
print(json.dumps({"systemMessage": sys.argv[1]}))' "$1"
}

if [ "$event" = "PreCompact" ]; then
  emit_msg "Before this context is compacted, flush anything unsaved to today's journal ($TODAY) via the outl tools, per ~/.claude/memory/AGENTS.md. In particular: (1) the slugs you retrieved this session plus the conclusion you drew from each, so you can re-fetch precisely after compaction discards the page bodies; and (2) any unsaved decisions, discoveries, or durable facts. Write IMPACTFUL facts through to their deep-memory leaf now (see the Two-tier writes section)."
  exit 0
fi

# ---- UserPromptSubmit: push-retrieval (surface memory relevant to THIS prompt) ------
# Runs the local FTS/graph index against the user's actual prompt BEFORE the model sees
# it, and injects the top few STRONG keyword hits as compact pointers. Turns memory from
# pull-when-the-agent-remembers into push-when-relevant, with no tool round-trip. Gated
# conservatively (bm25 score ceiling + >=2 content terms + per-session dedupe) so a
# trivial/off-topic prompt injects nothing. Skipped inside the headless memory agents
# (they have no user prompt). Never fails the turn.
if [ "$event" = "UserPromptSubmit" ]; then
  if [ -x "$MEMIDX" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && [ -z "${MEMORY_DUMP_ACTIVE:-}" ]; then
    ctx="$(MEMORY_PUSH_MAXSCORE="${MEMORY_PUSH_MAXSCORE:--8.0}" \
           MEMORY_PUSH_K="${MEMORY_PUSH_K:-3}" MEMIDX="$MEMIDX" WS="$WS" \
           python3 - "$input" <<'PY'
import os, sys, json, subprocess, re, glob, time
try:
    d = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
prompt = (d.get("prompt") or "").strip()
sid = d.get("session_id") or "nosid"
# Skip slash/bang commands and prompts too thin to carry a recall signal.
if not prompt or prompt[0] in "/!":
    sys.exit(0)
STOP = set("a an the and or of to in is are was be for on with as at by it this that these "
           "those i you we they my our your do does did can could should would will how what "
           "why when where who which please thanks yes no not go make add fix run use".split())
terms = [t for t in re.findall(r"[A-Za-z0-9_]+", prompt.lower()) if t not in STOP and len(t) > 1]
if len(terms) < 2:
    sys.exit(0)
memidx, ws = os.environ["MEMIDX"], os.environ["WS"]
maxscore, k = float(os.environ["MEMORY_PUSH_MAXSCORE"]), int(os.environ["MEMORY_PUSH_K"])
try:
    out = subprocess.run([memidx, "-w", ws, "search", "--json", prompt, "-k", str(k)],
                         capture_output=True, text=True, timeout=10).stdout
    results = json.loads(out)["results"]
except Exception:
    sys.exit(0)
# Strong keyword hits only (bm25 lower == better; keep score <= gate); best score per slug.
best = {}
for r in results:
    if r["kind"] != "hit" or r["score"] is None or r["score"] > maxscore:
        continue
    if r["slug"] not in best or r["score"] < best[r["slug"]]["score"]:
        best[r["slug"]] = r
if not best:
    sys.exit(0)
# Per-session dedupe so a slug is surfaced at most once per session.
cdir = os.path.join(ws, ".push-cache")
os.makedirs(cdir, exist_ok=True)
cfile = os.path.join(cdir, re.sub(r"[^A-Za-z0-9_-]", "_", sid))
seen = set()
try:
    with open(cfile) as f:
        seen = {ln.strip() for ln in f if ln.strip()}
except Exception:
    pass
fresh = sorted((r for s, r in best.items() if s not in seen), key=lambda r: r["score"])[:k]
if not fresh:
    sys.exit(0)
for old in glob.glob(os.path.join(cdir, "*")):  # opportunistic GC of stale session caches
    try:
        if time.time() - os.path.getmtime(old) > 86400:
            os.remove(old)
    except Exception:
        pass
try:
    with open(cfile, "a") as f:
        for r in fresh:
            f.write(r["slug"] + "\n")
except Exception:
    pass
lines = ["Relevant memory (auto-surfaced from your prompt — POINTERS only; "
         "`outl_page_get <slug>` to read the full page before relying on it):"]
for r in fresh:
    lines.append(f"- {r['slug']} › {r['heading']} — {r['snippet'][:140]}")
print("\n".join(lines))
PY
)"
    [ -n "$ctx" ] && CTX="$ctx" emit "UserPromptSubmit"
  fi
  exit 0
fi

# ---- PostToolUse: credit a page fetch to frecency (close the reinforcement loop) ----
# A successful outl_page_get is an unambiguous "this leaf mattered" signal, so bump its
# frecency (touch self-skips non-knowledge slugs and caps at 60). This is the missing
# counterpart to the daily decay sweep. Fire-and-forget; never blocks or fails the turn.
# Skipped inside the headless memory agents (their reads are maintenance, not use).
if [ "$event" = "PostToolUse" ]; then
  if [ -x "$MEMIDX" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && [ -z "${MEMORY_DUMP_ACTIVE:-}" ]; then
    slug="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    d = json.load(sys.stdin)
    if d.get("tool_name") == "mcp__outl__outl_page_get":
        print(((d.get("tool_input") or {}).get("slug") or "").strip())
except Exception:
    pass' 2>/dev/null)"
    if [ -n "$slug" ]; then
      ( "$MEMIDX" -w "$WS" touch "$slug" >/dev/null 2>&1 & )
      disown 2>/dev/null || true
    fi
  fi
  exit 0
fi

# ---- SessionEnd: flush the session's durable facts to today's journal -------
# Journaling on close does not depend on a compaction ever happening. Spawn the
# detached headless journaler (Sonnet 5) with the transcript path — unless we're
# already inside a spawned agent (its own SessionEnd must not re-trigger us).
if [ "$event" = "SessionEnd" ]; then
  if [ -z "${MEMORY_DUMP_ACTIVE:-}" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] \
     && [ -x "$DUMP" ] && command -v "$CLAUDE" >/dev/null 2>&1; then
    tpath="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    print(json.load(sys.stdin).get("transcript_path", ""))
except Exception:
    print("")' 2>/dev/null)"
    if [ -n "$tpath" ]; then
      MEMORY_DUMP_TRANSCRIPT="$tpath" nohup "$DUMP" >/dev/null 2>&1 &
      disown 2>/dev/null || true
    fi
  fi
  exit 0
fi

# ---- SessionStart (default) ----
ctx="You have persistent memory: an outl graph at ~/.claude/memory. Current state is below; retrieve detail on demand with outl_page_get (do not brute-force the graph). Protocol: ~/.claude/memory/AGENTS.md."$'\n\n'

# Table of contents (index page), with a raw-file fallback.
toc="$("$OUTL" export md index -w "$WS" 2>/dev/null)"
[ -z "$toc" ] && [ -f "$WS/pages/index.md" ] && toc="$(cat "$WS/pages/index.md" 2>/dev/null)"
[ -n "$toc" ] && ctx+="## Memory index (TOC)"$'\n\n'"$toc"$'\n\n'

# Recent workflow window (statically loaded, so it's cached and cheap — not re-fetched
# via tool calls mid-session): today's journal IN FULL, plus the `## Focus` digest of the
# previous up-to-4 dated journals. That is the recent-5 high-res window in bounded form —
# each prior day contributes only its day's-work TOC; pull a full prior journal on demand
# with outl_daily_get when a digest line points somewhere you need to read.
tf="$WS/journals/$TODAY.md"
[ -f "$tf" ] && ctx+="## Journal $TODAY"$'\n\n'"$(cat "$tf" 2>/dev/null)"$'\n\n'

# Append discipline — injected every session because the mechanical rule lives in
# AGENTS.md, which sessions are told NOT to read routinely. Without this reminder in
# front of them, sessions reach for the flat outl_daily_append with a "## Header\n- ..."
# blob and sprout duplicate ## Focus / ## Discoveries blocks (see AGENTS.md 'Scaffold once').
ctx+="Writing to the journal: it has five fixed sections — ## Focus / ## Key Decisions / ## Discoveries / ## Action Items / ## Session Notes, laid down ONCE by the journal template. Append each item as a CHILD under the matching EXISTING section: read the journal outline (outl_daily_today / outl_daily_get) to get that section's block id, then outl_block_append under it with NO '## ' header in the text. NEVER use outl_daily_append for section content (it appends a flat top-level block and cannot nest), and NEVER emit a '## Section' that already exists — that is exactly what sprouts duplicate ## Focus / ## Discoveries blocks. Full protocol in AGENTS.md."$'\n\n'
prev="$(ls "$WS"/journals/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md 2>/dev/null \
        | grep -v "/$TODAY\.md$" | sort -r | head -4)"
digest=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  d="$(basename "$f" .md)"
  # Extract the `## Focus` section: from its bullet-heading to the next `## ` section.
  focus="$(awk '/^[[:space:]]*-[[:space:]]+## Focus/{p=1;print;next} /^[[:space:]]*-[[:space:]]+## /{p=0} p' "$f" 2>/dev/null)"
  [ -n "$focus" ] && digest+="### $d"$'\n'"$focus"$'\n\n'
done <<< "$prev"
[ -n "$digest" ] && ctx+="## Recent journal focus (prior days — full text via outl_daily_get <date>)"$'\n\n'"$digest"

# Retrieval index (memory-index): keep it fresh, then tell the agent whether the
# graph is large enough that the index is ACTIVE (search-first) or not (TOC descent).
# Best-effort and non-fatal: if the tool or its deps are missing, memory just works
# via TOC traversal, exactly as before.
if [ -x "$MEMIDX" ]; then
  "$MEMIDX" -w "$WS" refresh >/dev/null 2>&1 || true
  stats="$("$MEMIDX" -w "$WS" stats --json 2>/dev/null)"
  active="$(printf '%s' "$stats" | python3 -c 'import sys, json
try:
    print("1" if json.load(sys.stdin).get("active") else "0")
except Exception:
    print("")' 2>/dev/null)"
  if [ "$active" = "1" ]; then
    ctx+="Retrieval: the memory-index is ACTIVE for this graph. To recall, run \`memory-index search \"<query terms>\"\` FIRST (keyword/FTS5, then a walk of the typed [[link]] graph out from the hits — labelled via·type·hops·weight), then \`outl_page_get\` the slugs it names. Hop depth is set by graph size. Per the 'Retrieval regime auto-scales' section of AGENTS.md. Fall back to TOC descent if it returns nothing."$'\n\n'
  fi

  # Consolidation — EVERY session (not marker-gated), so a missed reminder is caught
  # the next session, not lost until tomorrow. Two halves:
  #   * reap (mechanical): delete aged journals the agent already marked consolidated::
  #     — guarded, so an undistilled journal is never deleted.
  #   * distill (LLM): if any aged journal is still un-distilled, run it AUTOMATICALLY
  #     in a detached, headless `claude -p` agent (memory-consolidate) so it happens
  #     with no prompting, on any machine. The interactive MANDATORY directive is now
  #     only the fallback for when the claude CLI or the script is unavailable.
  # Cheap pure-bash pre-check first: retention is by COUNT — keep the 5 most recent
  # dated journals, age out anything older. In steady state there are exactly 5 on disk,
  # so we skip the subprocess entirely — the common session pays nothing. We only spin up
  # the tool when a 6th (or more) journal exists.
  jcount=0
  for f in "$WS"/journals/*.md; do
    [ -e "$f" ] || continue
    b="$(basename "$f" .md)"
    case "$b" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) jcount=$((jcount + 1)) ;; esac
  done
  aged_exists=0
  [ "$jcount" -gt 5 ] && aged_exists=1
  pend=""
  if [ "$aged_exists" = 1 ]; then
    con="$("$MEMIDX" -w "$WS" consolidate --reap --json 2>/dev/null)"
    pend="$(printf '%s' "$con" | python3 -c 'import sys, json
try:
    print(" ".join(json.load(sys.stdin).get("pending", [])))
except Exception:
    print("")' 2>/dev/null)"
  fi
  # Skip entirely inside the headless consolidation agent's own session (it has its
  # own -p prompt); only act for real interactive sessions.
  if [ -n "$pend" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ]; then
    # A journal still pending at THIS session start means any prior background run did
    # NOT clear it (the reap above already ran). Count consecutive automatic attempts
    # per journal so a silently-failing agent can't loop forever — unseen, and
    # re-billing a `claude -p` every morning. Once a journal has been auto-attempted
    # MAX_CONSOLIDATE_ATTEMPTS times without clearing, we stop launching and surface
    # the interactive fallback so the stuck backlog becomes visible.
    maxtries=0
    newstate=""
    for j in $pend; do
      prior="$(awk -v s="$j" '$1==s{print $2; exit}' "$ATTEMPTS" 2>/dev/null)"
      case "$prior" in ''|*[!0-9]*) prior=0 ;; esac
      tries=$((prior + 1))
      [ "$tries" -gt "$maxtries" ] && maxtries=$tries
      newstate+="$j $tries"$'\n'
    done
    # Rewrite with only the still-pending journals, so a cleared one drops its counter.
    printf '%s' "$newstate" > "$ATTEMPTS" 2>/dev/null || true

    if [ -x "$CONS" ] && command -v "$CLAUDE" >/dev/null 2>&1 \
       && [ "$maxtries" -le "$MAX_CONSOLIDATE_ATTEMPTS" ]; then
      # Automatic path: distill + reap in a detached background agent. SessionStart
      # returns immediately; the backlog clears with zero prompting, every install.
      nohup "$CONS" >/dev/null 2>&1 &
      disown 2>/dev/null || true
      ctx+="Memory consolidation is running automatically in a background agent for aged journals ($pend) — it will distill them into the knowledge tree and reap them. Do NOT consolidate or delete journals yourself."$'\n\n'
    else
      # Fallback: either the tooling is missing (no claude CLI / no memory-consolidate),
      # OR the background agent has failed to clear these journals MAX_CONSOLIDATE_ATTEMPTS
      # times — in which case we pause the silent, re-billing retry loop and have THIS
      # interactive session do the distillation instead.
      if [ -x "$CONS" ] && command -v "$CLAUDE" >/dev/null 2>&1; then
        ctx+="⚠ Automatic background consolidation has not cleared these journals after $MAX_CONSOLIDATE_ATTEMPTS attempt(s) ($pend); auto-retry is paused to avoid a silent, re-billing loop. Do the consolidation in THIS session instead, as below."$'\n\n'
      fi
      ctx+="⚠ CONSOLIDATION REQUIRED before other work this session — these journals are older than the 5 most recent and are NOT yet distilled: $pend. For EACH date, per the Condensation section of AGENTS.md: cluster its items by the [[page]] they concern, merge the distilled points into the right knowledge leaf (create/split as needed; set each such leaf's \`updated:: $TODAY\` plus summary::/frecency). Then, as the LAST actions for that date: (1) record evidence — \`outl_page_prop_set <date> distilled-into='[[slug-a]] [[slug-b]]'\` listing every leaf you wrote to, or \`distilled-into=none\` if nothing was durable; (2) \`outl_page_prop_set <date> consolidated=$TODAY\`. The reap deletes any aged journal carrying a \`consolidated::\` mark, so marking it done is what removes it — do NOT delete journals yourself. Do this now, then address the user's request."$'\n\n'
    fi
  else
    # No backlog (or we're the headless agent). Clear stale counters only when the
    # backlog is genuinely empty, so a future backlog starts its count fresh.
    [ -z "$pend" ] && rm -f "$ATTEMPTS" 2>/dev/null || true
  fi
fi

# Once-per-new-day work (frecency sweep). The consolidation backlog is handled every
# session above, not here, so a missed reminder is never lost until the next day.
last=""
[ -f "$MARKER" ] && last="$(cat "$MARKER" 2>/dev/null)"
if [ "$last" != "$TODAY" ]; then
  # Mechanized frecency sweep (once per new day): decay non-pinned `type:: knowledge`
  # leaves by 1 (seed 30) via `outl page prop set` — sidecar-safe, never raw edits —
  # and surface any leaf that reached 0 as a prune candidate for review. Deletion is
  # NOT automatic (it needs parent-TOC link cleanup), so it stays an agent decision.
  if [ -x "$MEMIDX" ]; then
    sweep="$("$MEMIDX" -w "$WS" maintain --json 2>/dev/null)"
    "$MEMIDX" -w "$WS" refresh >/dev/null 2>&1 || true   # re-index the decayed frontmatter
    cands="$(printf '%s' "$sweep" | python3 -c 'import sys, json
try:
    print(" ".join(json.load(sys.stdin).get("prune_candidates", [])))
except Exception:
    print("")' 2>/dev/null)"
    if [ -n "$cands" ]; then
      ctx+="⚠ Frecency prune candidates (reached 0 in today's sweep): $cands — per the Frecency & pruning section of AGENTS.md, decide for each whether to delete it (outl_page_delete, then remove its parent-TOC link) or bump its frecency if it's still relevant."$'\n\n'
    fi
  fi

  printf '%s' "$TODAY" > "$MARKER" 2>/dev/null || true
fi

CTX="$ctx" emit "SessionStart"
exit 0
