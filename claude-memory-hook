#!/usr/bin/env bash
#
# Claude Code persistent-memory hook.
#   SessionStart -> inject the memory index (TOC) + recent journals as context,
#                   and, on the first session of a new day, flag journals that
#                   have aged out of the retention window for condensation.
#   PreCompact   -> best-effort reminder to flush unsaved notes to the journal
#                   before the context is compacted.
#
# Reads the hook JSON on stdin, writes a hookSpecificOutput JSON on stdout.
# Wired via ~/.claude/settings.json. Designed to never fail a session (exit 0).
# See ~/.claude/memory/AGENTS.md for the protocol this supports.

OUTL="${OUTL_BIN:-/opt/homebrew/bin/outl}"
MEMIDX="${MEMORY_INDEX_BIN:-$HOME/.local/bin/memory-index}"
CONS="${MEMORY_CONSOLIDATE_BIN:-$HOME/.local/bin/memory-consolidate}"
DUMP="${MEMORY_DUMP_BIN:-$HOME/.local/bin/claude-memory-dump}"
CLAUDE="${CLAUDE_BIN:-claude}"
# Hooks can run with a minimal PATH; fall back to the usual install location.
command -v "$CLAUDE" >/dev/null 2>&1 || CLAUDE="$HOME/.local/bin/claude"
WS="${MEMORY_WS:-$HOME/.claude/memory}"   # override targets an isolated workspace (tests)
MARKER="$WS/.last-session-date"
ATTEMPTS="$WS/.consolidate-attempts"    # per-journal count of consecutive auto-consolidation attempts
MAX_CONSOLIDATE_ATTEMPTS=2              # auto-retry a stuck journal this many times, then surface it
TODAY="$(date +%F)"

input="$(cat)"
event="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    print(json.load(sys.stdin).get("hook_event_name", ""))
except Exception:
    print("")' 2>/dev/null)"

# emit <hookEventName>  (context text taken from $CTX)
# additionalContext is the supported channel for SessionStart; use it there only.
emit() {
  python3 -c 'import json, os, sys
print(json.dumps({"hookSpecificOutput": {"hookEventName": sys.argv[1], "additionalContext": os.environ.get("CTX", "")}}))' "$1"
}

# emit_msg <text>  — surface a message to the model via the top-level systemMessage
# field. PreCompact does NOT honour additionalContext, so its reminder must go
# through systemMessage or it is silently dropped.
emit_msg() {
  python3 -c 'import json, sys
print(json.dumps({"systemMessage": sys.argv[1]}))' "$1"
}

if [ "$event" = "PreCompact" ]; then
  emit_msg "Before this context is compacted, flush anything unsaved to today's journal ($TODAY) via the outl tools, per ~/.claude/memory/AGENTS.md. In particular: (1) the slugs you retrieved this session plus the conclusion you drew from each, so you can re-fetch precisely after compaction discards the page bodies; and (2) any unsaved decisions, discoveries, or durable facts. Write IMPACTFUL facts through to their deep-memory leaf now (see the Two-tier writes section)."
  exit 0
fi

# ---- UserPromptSubmit: push-retrieval ----
# Run the FTS/graph index on the prompt; inject top strong keyword hits as pointers.
# Gated (index active + bm25 ceiling + >=2 content terms + per-session dedupe). Skipped in
# headless agents. The sync search runs WITHOUT --credit (pointers only, ~44ms cheaper); the
# section-frecency credit is DETACHED to the background so it stays off the critical path
# (perf-research 3.1/3.2). One python call does the search AND emits the hook JSON (3.3).
if [ "$event" = "UserPromptSubmit" ]; then
  # 3.1: skip entirely when the index is inactive (small graph — the whole TOC is already
  # injected at SessionStart). The flag is published by SessionStart; missing/empty = enabled.
  if [ -x "$MEMIDX" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && [ -z "${MEMORY_DUMP_ACTIVE:-}" ] \
     && [ "$(cat "$WS/.push-active" 2>/dev/null)" != "0" ]; then
    out="$(MEMORY_PUSH_MAXSCORE="${MEMORY_PUSH_MAXSCORE:--8.0}" \
           MEMORY_PUSH_K="${MEMORY_PUSH_K:-3}" MEMIDX="$MEMIDX" WS="$WS" \
           python3 - "$input" <<'PY'
import os, sys, json, subprocess, re, glob, time
try:
    d = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
prompt = (d.get("prompt") or "").strip()
sid = d.get("session_id") or "nosid"
# Skip slash/bang commands and prompts too thin to carry a recall signal.
if not prompt or prompt[0] in "/!":
    sys.exit(0)
STOP = set("a an the and or of to in is are was be for on with as at by it this that these "
           "those i you we they my our your do does did can could should would will how what "
           "why when where who which please thanks yes no not go make add fix run use".split())
terms = [t for t in re.findall(r"[A-Za-z0-9_]+", prompt.lower()) if t not in STOP and len(t) > 1]
if len(terms) < 2:
    sys.exit(0)
memidx, ws = os.environ["MEMIDX"], os.environ["WS"]
maxscore, k = float(os.environ["MEMORY_PUSH_MAXSCORE"]), int(os.environ["MEMORY_PUSH_K"])
# Detach the section-frecency credit so it never blocks the turn (3.2). Same query, --credit,
# fire-and-forget in its own session; its output is discarded.
try:
    subprocess.Popen([memidx, "-w", ws, "search", "--json", "--credit", "--no-graph", prompt,
                      "-k", str(k)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
except Exception:
    pass
try:
    # Sync search for the POINTERS only (no --credit): pointers need the hits, not the write.
    out = subprocess.run([memidx, "-w", ws, "search", "--json", prompt, "-k", str(k)],
                         capture_output=True, text=True, timeout=10).stdout
    results = json.loads(out)["results"]
except Exception:
    sys.exit(0)
# Strong keyword hits only (bm25 lower == better; keep score <= gate); best score per slug.
best = {}
for r in results:
    if r["kind"] != "hit" or r["score"] is None or r["score"] > maxscore:
        continue
    if r["slug"] not in best or r["score"] < best[r["slug"]]["score"]:
        best[r["slug"]] = r
if not best:
    sys.exit(0)
# Per-session dedupe so a slug is surfaced at most once per session.
cdir = os.path.join(ws, ".push-cache")
os.makedirs(cdir, exist_ok=True)
cfile = os.path.join(cdir, re.sub(r"[^A-Za-z0-9_-]", "_", sid))
seen = set()
try:
    with open(cfile) as f:
        seen = {ln.strip() for ln in f if ln.strip()}
except Exception:
    pass
fresh = sorted((r for s, r in best.items() if s not in seen), key=lambda r: r["score"])[:k]
if not fresh:
    sys.exit(0)
for old in glob.glob(os.path.join(cdir, "*")):  # opportunistic GC of stale session caches
    try:
        if time.time() - os.path.getmtime(old) > 86400:
            os.remove(old)
    except Exception:
        pass
try:
    with open(cfile, "a") as f:
        for r in fresh:
            f.write(r["slug"] + "\n")
except Exception:
    pass
lines = ["Relevant memory (auto-surfaced from your prompt — POINTERS only; "
         "`outl_page_get <slug>` to read the full page before relying on it):"]
for r in fresh:
    lines.append(f"- {r['slug']} › {r['heading']} — {r['snippet'][:140]}")
# Emit the hook JSON directly (3.3: no separate emit python spawn).
print(json.dumps({"hookSpecificOutput": {
    "hookEventName": "UserPromptSubmit", "additionalContext": "\n".join(lines)}}))
PY
)"
    [ -n "$out" ] && printf '%s' "$out"
  fi
  exit 0
fi

# ---- PostToolUse: credit a page fetch to frecency ----
# outl_page_get bumps the slug's frecency (touch skips non-knowledge slugs, caps at 60).
# Fire-and-forget. Skipped in headless agents (their reads are maintenance, not use).
if [ "$event" = "PostToolUse" ]; then
  if [ -x "$MEMIDX" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] && [ -z "${MEMORY_DUMP_ACTIVE:-}" ]; then
    slug="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    d = json.load(sys.stdin)
    if d.get("tool_name") == "mcp__outl__outl_page_get":
        print(((d.get("tool_input") or {}).get("slug") or "").strip())
except Exception:
    pass' 2>/dev/null)"
    if [ -n "$slug" ]; then
      ( "$MEMIDX" -w "$WS" touch "$slug" >/dev/null 2>&1 & )
      disown 2>/dev/null || true
    fi
  fi
  exit 0
fi

# ---- SessionEnd: flush the session's durable facts to today's journal -------
# Spawn the detached headless journaler (Sonnet 5) with the transcript path, unless
# already inside a spawned agent (its own SessionEnd must not re-trigger us).
if [ "$event" = "SessionEnd" ]; then
  if [ -z "${MEMORY_DUMP_ACTIVE:-}" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ] \
     && [ -x "$DUMP" ] && command -v "$CLAUDE" >/dev/null 2>&1; then
    tpath="$(printf '%s' "$input" | python3 -c 'import sys, json
try:
    print(json.load(sys.stdin).get("transcript_path", ""))
except Exception:
    print("")' 2>/dev/null)"
    if [ -n "$tpath" ]; then
      MEMORY_DUMP_TRANSCRIPT="$tpath" nohup "$DUMP" >/dev/null 2>&1 &
      disown 2>/dev/null || true
    fi
  fi
  exit 0
fi

# ---- SessionStart (default) ----
ctx="Persistent cross-session memory: an outl graph at ~/.claude/memory — your active persistence layer, always loaded (state below), the FIRST place you look before code, a file/dir search, or the web. A UserPromptSubmit hook also PUSHES prompt-relevant slugs as a 'Relevant memory (auto-surfaced …)' pointer block before you act — pointers only, so outl_page_get to confirm (that fetch credits frecency); their absence does not mean memory is empty. Work from the injected index + journals below; for anything deeper dispatch the memory-recall subagent (Sonnet, read-only) — it walks the graph in isolation and returns the conclusion + [[slugs]] with the page bodies kept off this thread. Reserve a direct outl_page_get for a quick single-slug read; never brute-force the graph. Curate as you go: append durable decisions/discoveries to today's journal at each checkpoint, and write impactful facts through to their leaf. Full protocol (read only for maintenance): ~/.claude/memory/AGENTS.md."$'\n\n'

# Table of contents (index page), with a raw-file fallback.
toc="$("$OUTL" export md index -w "$WS" 2>/dev/null)"
[ -z "$toc" ] && [ -f "$WS/pages/index.md" ] && toc="$(cat "$WS/pages/index.md" 2>/dev/null)"
[ -n "$toc" ] && ctx+="## Memory index (TOC)"$'\n\n'"$toc"$'\n\n'

# Recent workflow window: today's journal + the `## Focus` digest of the prior up-to-4
# dated journals. Pull a full prior journal with outl_daily_get.
# focus_of: extract a journal's `## Focus` subtree (heading bullet to next `## ` section).
focus_of() { awk '/^[[:space:]]*-[[:space:]]+## Focus/{p=1;print;next} /^[[:space:]]*-[[:space:]]+## /{p=0} p' "$1" 2>/dev/null; }

# Inject today's journal in full while small; over MEMORY_TODAY_MAXBYTES inject only its
# `## Focus` digest, with a pointer to pull the rest via outl_daily_today.
tf="$WS/journals/$TODAY.md"
if [ -f "$tf" ]; then
  tbytes="$(wc -c <"$tf" 2>/dev/null | tr -d ' ')"
  case "$tbytes" in ''|*[!0-9]*) tbytes=0 ;; esac
  if [ "$tbytes" -le "${MEMORY_TODAY_MAXBYTES:-6000}" ]; then
    ctx+="## Journal $TODAY"$'\n\n'"$(cat "$tf" 2>/dev/null)"$'\n\n'
  else
    tfocus="$(focus_of "$tf")"
    ctx+="## Journal $TODAY (Focus digest — today's journal is large; pull it in full, incl. Decisions/Discoveries/Open threads, via outl_daily_today)"$'\n\n'"${tfocus}"$'\n\n'
  fi
fi

# Journal-append discipline, injected every session (rule lives in AGENTS.md).
ctx+="Journal writing: the day's sections are laid down ONCE by the template. Append each item as a CHILD of the matching EXISTING section — get its block id from outl_daily_today, then outl_block_append under it with NO '## ' header in the text. NEVER use outl_daily_append for section content (it appends a flat top-level block and cannot nest), and NEVER emit a '## Section' that already exists — that is what sprouts duplicate section blocks. Full protocol in AGENTS.md."$'\n\n'
prev="$(ls "$WS"/journals/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md 2>/dev/null \
        | grep -v "/$TODAY\.md$" | sort -r | head -4)"
digest=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  d="$(basename "$f" .md)"
  focus="$(focus_of "$f")"
  [ -n "$focus" ] && digest+="### $d"$'\n'"$focus"$'\n\n'
done <<< "$prev"
[ -n "$digest" ] && ctx+="## Recent journal focus (prior days — full text via outl_daily_get <date>)"$'\n\n'"$digest"

# Retrieval index: refresh it, then report whether it is ACTIVE (search-first) or not
# (TOC descent). Non-fatal: if missing, memory works via TOC traversal.
if [ -x "$MEMIDX" ]; then
  "$MEMIDX" -w "$WS" refresh >/dev/null 2>&1 || true
  stats="$("$MEMIDX" -w "$WS" stats --json 2>/dev/null)"
  active="$(printf '%s' "$stats" | python3 -c 'import sys, json
try:
    print("1" if json.load(sys.stdin).get("active") else "0")
except Exception:
    print("")' 2>/dev/null)"
  # Publish the active flag so UserPromptSubmit can cheaply gate push-retrieval (3.1) without
  # its own stats subprocess. Fail-open: an empty value (stats error) leaves push enabled.
  printf '%s' "$active" > "$WS/.push-active" 2>/dev/null || true
  if [ "$active" = "1" ]; then
    ctx+="Retrieval: the memory-index is ACTIVE. To recall, run \`memory-index search \"<terms>\"\` FIRST (FTS5 + a walk of the typed [[link]] graph out from the hits), then \`outl_page_get\` the slugs it names; fall back to TOC descent if it returns nothing. Per AGENTS.md 'Retrieval regime auto-scales'."$'\n\n'
  fi

  # Consolidation, every session (not marker-gated). Two halves:
  #   * reap: delete aged journals already marked consolidated:: (guarded).
  #   * distill: run any un-distilled aged journal via detached memory-consolidate agent;
  #     interactive directive is the fallback when the CLI/script is unavailable.
  # Retention is by COUNT (keep 5 most recent); pure-bash pre-check skips the subprocess
  # unless a 6th journal exists.
  jcount=0
  for f in "$WS"/journals/*.md; do
    [ -e "$f" ] || continue
    b="$(basename "$f" .md)"
    case "$b" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) jcount=$((jcount + 1)) ;; esac
  done
  aged_exists=0
  [ "$jcount" -gt 5 ] && aged_exists=1
  pend=""
  if [ "$aged_exists" = 1 ]; then
    con="$("$MEMIDX" -w "$WS" consolidate --reap --json 2>/dev/null)"
    pend="$(printf '%s' "$con" | python3 -c 'import sys, json
try:
    print(" ".join(json.load(sys.stdin).get("pending", [])))
except Exception:
    print("")' 2>/dev/null)"
  fi
  # Skip inside the headless consolidation agent's own session; act only for interactive sessions.
  if [ -n "$pend" ] && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ]; then
    # Still-pending here means a prior background run did not clear it. Count consecutive
    # auto-attempts per journal; after MAX_CONSOLIDATE_ATTEMPTS, stop launching and surface
    # the interactive fallback.
    maxtries=0
    newstate=""
    for j in $pend; do
      prior="$(awk -v s="$j" '$1==s{print $2; exit}' "$ATTEMPTS" 2>/dev/null)"
      case "$prior" in ''|*[!0-9]*) prior=0 ;; esac
      tries=$((prior + 1))
      [ "$tries" -gt "$maxtries" ] && maxtries=$tries
      newstate+="$j $tries"$'\n'
    done
    # Rewrite with only the still-pending journals, so a cleared one drops its counter.
    printf '%s' "$newstate" > "$ATTEMPTS" 2>/dev/null || true

    if [ -x "$CONS" ] && command -v "$CLAUDE" >/dev/null 2>&1 \
       && [ "$maxtries" -le "$MAX_CONSOLIDATE_ATTEMPTS" ]; then
      # Automatic path: distill + reap in a detached agent.
      nohup "$CONS" >/dev/null 2>&1 &
      disown 2>/dev/null || true
      ctx+="Memory consolidation is running automatically in a background agent for aged journals ($pend) — it will distill them into the knowledge tree and reap them. Do NOT consolidate or delete journals yourself."$'\n\n'
    else
      # Fallback: tooling missing, or background agent failed MAX_CONSOLIDATE_ATTEMPTS times.
      # Pause auto-retry; have THIS session do the distillation.
      if [ -x "$CONS" ] && command -v "$CLAUDE" >/dev/null 2>&1; then
        ctx+="⚠ Automatic background consolidation has not cleared these journals after $MAX_CONSOLIDATE_ATTEMPTS attempt(s) ($pend); auto-retry is paused to avoid a silent, re-billing loop. Do the consolidation in THIS session instead, as below."$'\n\n'
      fi
      ctx+="⚠ CONSOLIDATION REQUIRED before other work this session — these journals are older than the 5 most recent and are NOT yet distilled: $pend. For EACH date, per the Condensation section of AGENTS.md: cluster its items by the [[page]] they concern, merge the distilled points into the right knowledge leaf (create/split as needed; set each such leaf's \`updated:: $TODAY\` plus summary::/frecency). Then, as the LAST actions for that date: (1) record evidence — \`outl_page_prop_set <date> distilled-into='[[slug-a]] [[slug-b]]'\` listing every leaf you wrote to, or \`distilled-into=none\` if nothing was durable; (2) \`outl_page_prop_set <date> consolidated=$TODAY\`. The reap deletes any aged journal carrying a \`consolidated::\` mark, so marking it done is what removes it — do NOT delete journals yourself. Do this now, then address the user's request."$'\n\n'
    fi
  else
    # No backlog (or headless agent). Clear counters only when backlog empty.
    [ -z "$pend" ] && rm -f "$ATTEMPTS" 2>/dev/null || true
  fi
fi

# Once-per-new-day work (frecency sweep).
last=""
[ -f "$MARKER" ] && last="$(cat "$MARKER" 2>/dev/null)"
if [ "$last" != "$TODAY" ]; then
  # Frecency sweep (silent, mechanical): decay every page + content line by 1 and EVICT
  # anything that reached 0 — soft-trash + reference scrub, no prompt and no message. Then
  # hand only the two generative jobs (journal distill + oversized split) to the detached
  # agent. Everything is backgrounded so SessionStart never blocks and nothing is surfaced.
  if [ -x "$MEMIDX" ]; then
    (
      "$MEMIDX" -w "$WS" maintain >/dev/null 2>&1
      "$MEMIDX" -w "$WS" refresh >/dev/null 2>&1
      # Daily op-log compaction (4.3): drops provably-inert ops so the log the workspace
      # replays on every boot stops growing unbounded. Runs after maintain/refresh (their
      # outl subprocesses have exited) and BEFORE the consolidation agent grabs the workspace;
      # `compact` refuses while another outl process holds it and backs up before rewriting.
      # --no-horizon also reclaims inert ops from the last 30 days; safe ONLY with no
      # paired peers (no peer can hold undelivered ops), so gate on an empty peer list.
      if "$OUTL" -w "$WS" peer list 2>/dev/null | grep -q "No paired devices"; then
        "$OUTL" -w "$WS" compact --apply --no-horizon >/dev/null 2>&1 || true
      else
        "$OUTL" -w "$WS" compact --apply >/dev/null 2>&1 || true
      fi
      if [ -x "$CONS" ] && command -v "$CLAUDE" >/dev/null 2>&1 && [ -z "${MEMORY_CONSOLIDATE_ACTIVE:-}" ]; then
        "$CONS" >/dev/null 2>&1
      fi
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi

  printf '%s' "$TODAY" > "$MARKER" 2>/dev/null || true
fi

CTX="$ctx" emit "SessionStart"
exit 0
